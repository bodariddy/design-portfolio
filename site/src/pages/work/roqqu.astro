---
import Case from '../../layouts/Case.astro';
import Screens from '../../components/case/Screens.astro';
import Draft from '../../components/case/Draft.astro';
import { Image } from 'astro:assets';

const img = import.meta.glob<{ default: ImageMetadata }>('../../assets/work/roqqu/*.webp', { eager: true });
const s = (n: string) => img[`../../assets/work/roqqu/${n}.webp`].default;

const kyc = [
  { src: s('kyc-start'), alt: 'Verify your identity screen listing what is needed up front', cap: 'What we need, said up front' },
  { src: s('kyc-bvn'), alt: 'Enter your BVN screen', cap: 'One question per screen, with the why' },
  { src: s('kyc-selfie'), alt: 'Take a selfie screen with tips', cap: 'Tips before the camera opens' },
  { src: s('kyc-selfie-capture'), alt: 'Guided liveness capture asking the user to tilt their face', cap: 'Guided liveness, one instruction at a time' },
  { src: s('kyc-processing'), alt: 'Verification processing screen with live checklist', cap: 'Processing you can watch' },
  { src: s('kyc-success'), alt: 'Identity verification successful screen', cap: 'A clear finish line' },
];
const tools = [
  { src: s('rate-checker'), alt: 'Rate checker converting BTC to USDT with popular pairs', cap: 'Rate checker: live, with “last updated”' },
  { src: s('network-result'), alt: 'Network checker showing supported networks for a pasted address', cap: 'Network checker: paste an address, see safe networks' },
  { src: s('txcheck-detail'), alt: 'Transaction checker with plain-language summary of a Bitcoin transaction', cap: 'Transaction checker: the chain, in plain English' },
  { src: s('txcheck-result'), alt: 'Transaction checker result for a sale', cap: 'Every detail, one tap to copy' },
];
const send = [
  { src: s('send-address'), alt: 'Send BTC address and network screen', cap: 'Address and network, nothing else' },
  { src: s('send-network'), alt: 'Select network sheet with a warning to match networks', cap: 'Network choice made explicit, with fees and ETA' },
  { src: s('send-confirm'), alt: 'Confirm transaction screen showing fee, arrival and balance after', cap: 'Confirm shows what lands, what it costs, what’s left' },
  { src: s('tx-progress-1'), alt: 'Transaction details processing state', cap: 'Then a live timeline…' },
  { src: s('tx-progress-done'), alt: 'Transaction details successful state', cap: '…to a clear “Successful”' },
];
const stocks = [
  { src: s('stocks-mode'), alt: 'Select your mode sheet: Crypto, Qash, Web3, Stocks & Commodities', cap: 'One app, four modes: a single switcher' },
  { src: s('stocks-intro'), alt: 'Own real-world assets digitally intro screen with key benefits', cap: 'Tokenised assets explained before the first buy' },
  { src: s('stocks-home'), alt: 'Stocks home with balance and featured stocks', cap: 'A home built around featured and tailored stocks' },
  { src: s('stocks-detail'), alt: 'Apple stock detail with chart and overview tabs', cap: 'Stock detail: chart, financials, news' },
  { src: s('stocks-buy'), alt: 'Buy Apple amount entry with keypad', cap: 'Buy in fiat amounts, fractions handled for you' },
  { src: s('stocks-milestone'), alt: 'Congratulations you just bought your first tokenised stock card', cap: 'A shareable first-stock milestone' },
  { src: s('stocks-dividends'), alt: 'Dividends dashboard with upcoming payouts', cap: 'Dividends: what you’ve earned and what’s next' },
  { src: s('stocks-pnl'), alt: 'Apple position profit and loss screen', cap: 'Position P&L across timeframes' },
];
const staking = [
  { src: s('stake-empty'), alt: 'Staking dashboard with no assets and popular coins to stake', cap: 'Empty state that teaches, then sells' },
  { src: s('stake-learn'), alt: 'How staking works explainer', cap: 'How it works, including the honest parts' },
  { src: s('stake-calc'), alt: 'Return calculator for staking', cap: 'Return calculator before any commitment' },
  { src: s('stake-confirm'), alt: 'Preview stake with APY, payout frequency, unstaking period and fees', cap: 'Preview: APY, payouts, unbonding, fees' },
  { src: s('stake-success'), alt: 'Staking initiated confirmation', cap: 'What happens next, in plain words' },
  { src: s('stake-dashboard'), alt: 'Staking dashboard with total staked value and positions', cap: 'Positions and rewards at a glance' },
  { src: s('stake-positions'), alt: 'Your positions list with active, deactivating and withdrawable tabs', cap: 'Every stake state made visible' },
];
const aeon = [
  { src: s('aeon-entry'), alt: 'Home screen with AI Trading Signals card', cap: 'Discovered in context, from home' },
  { src: s('aeon-intro'), alt: 'Trade with structured AI intelligence intro', cap: 'Positioned as structure, not hype' },
  { src: s('aeon-detail'), alt: 'BTC/USDT signal detail with setup and reasoning', cap: 'Every signal shows its reasoning' },
  { src: s('aeon-position'), alt: 'Taking a position from a signal with leverage', cap: 'From insight to position in one step' },
  { src: s('aeon-success'), alt: 'Trade accepted confirmation from signal', cap: 'Clear confirmation, with an undo' },
];
const contracts = [
  { src: s('ct-first'), alt: 'Futures first-time screen: Futures trading, for the rest of us', cap: '“Futures trading, for the rest of us”' },
  { src: s('ct-settings'), alt: 'Trade settings for margin mode and order type', cap: 'Margin and order types explained, safest recommended' },
  { src: s('ct-position'), alt: 'Taking a long position with leverage slider', cap: 'Liquidation price shown before you commit' },
  { src: s('ct-open'), alt: 'Open position detail with chart and stats', cap: 'Open position: P&L, entry, liquidation' },
  { src: s('ct-close'), alt: 'Close trade confirmation sheet', cap: 'Closing shows exactly what you lock in' },
  { src: s('ct-receipt'), alt: 'Shareable PnL receipt with referral QR code', cap: 'Shareable P&L card that doubles as a referral' },
  { src: s('ct-challenge'), alt: 'Daily trading challenge home', cap: 'Daily challenges with USDC prize pools' },
  { src: s('ct-bronze'), alt: 'Bronze challenge progress and performance summary', cap: 'Progress, rank and rules in one view' },
  { src: s('ct-leaderboard'), alt: 'Trading challenge leaderboard', cap: 'Leaderboards for healthy competition' },
];
---
<Case
  slug="roqqu"
  title="Making crypto feel safe enough to trade"
  sub="From a safer KYC and send flow to stocks, staking, AI signals and futures: designing how a crypto app became a multi-asset platform for users across Africa and Europe."
  meta={[
    ['Role', 'Senior Product Designer'],
    ['Team', 'Product design team of 5, plus PM & engineering'],
    ['Timeline', 'Nov 2023 – present'],
    ['Platform', 'iOS · Android'],
    ['Scope', 'Onboarding, payments, Stocks, Staking, AEON, Contracts'],
  ]}
  hero={s('hero-mockup')}
  heroAlt="Two Roqqu app screens on phones, showing the home balance and wallet"
  tldr={{
    problem: 'New users were dropping out of a long, confusing KYC, and existing users were nervous about moving money. One wrong network or one unclear status and trust was gone, and the support queue grew.',
    did: 'First I fixed the foundations where trust is won or lost: identity verification, sending and tracking crypto, fiat in and out with Qash, and self-serve tools. Then I designed the new products that turned Roqqu into a multi-asset platform: tokenised Stocks, non-custodial Staking, AEON AI signals and perpetual Contracts.',
  }}
  results={[
    { value: '−45%', label: 'onboarding time' },
    { value: '+22%', label: 'onboarding → first transaction' },
    { value: '+18%', label: 'successful trade completion' },
    { value: '101k', label: 'Qash transactions in year one' },
    { value: '−30%', label: 'support queries' },
  ]}
>
  <section class="wrap sec">
    <p class="side mono">01 · Context</p>
    <div class="txt" data-reveal>
      <p class="lead">In crypto, every tap feels high-stakes. Pick the wrong network and the money is gone. Don’t understand a status and you assume the worst.</p>
      <p>Roqqu lets people across Africa and Europe buy, sell, store and send crypto, and move between crypto and local currency. The business needed more sign-ups to become active traders, and fewer support tickets from people who didn’t understand what was happening to their funds.</p>
      <p>Over two years the app grew from a crypto exchange into a platform with four modes (Crypto, Qash, Web3 and Stocks), plus futures, AI signals, staking and cards. It was designed by a team of five. This case study covers the parts I owned, in two parts: fixing the foundations, then expanding the platform.</p>
    </div>
  </section>

  <section class="wrap sec">
    <p class="side mono">02 · My role</p>
    <div class="txt" data-reveal>
      <p>I’m a Senior Product Designer on the core product, working with product and engineering leadership on strategy for trading and Web3 wallet expansion. Alongside the design work, I introduced a structured discovery process (research synthesis, journey mapping and problem-framing workshops) that now feeds roadmap prioritisation.</p>
    </div>
  </section>

  <section class="wrap sec">
    <p class="side mono">03 · What we learned</p>
    <ol class="insights" role="list" data-reveal>
      <li><span class="mono">01</span><h3>Onboarding was the biggest leak</h3><p>KYC was long, unclear about what it needed, and failed silently.</p></li>
      <li><span class="mono">02</span><h3>Uncertainty drove support</h3><p>“Has my transaction gone through?” was the top query, and most tickets were people checking status rather than real problems.</p></li>
      <li><span class="mono">03</span><h3>Networks were scary</h3><p>Users didn’t understand networks or fees, and feared losing funds by choosing wrong.</p></li>
      <li><span class="mono">04</span><h3>People wanted to learn</h3><p>Many users wanted to understand crypto before committing real money.</p></li>
    </ol>
  </section>

  <div class="wrap part"><p class="mono">Part 1</p><h2>Fixing the <span class="serif">foundations</span></h2></div>
  <!-- Decisions -->
  <section class="decision">
    <div class="wrap d-head">
      <p class="mono d-n">Decision 01</p>
      <h2>KYC as a guided, recoverable journey</h2>
      <div class="d-cols" data-reveal>
        <div><h4 class="mono">Insight</h4><p>Users quit when they didn’t know how many steps were left, why a document was needed, or why it was rejected.</p></div>
        <div><h4 class="mono">Decision</h4><p>Say what we need up front. Ask one thing per screen and explain why. Coach before the camera opens, guide liveness one instruction at a time, and show processing as a live checklist with a clear finish.</p></div>
        <div><h4 class="mono">Result</h4><p class="big">−45% onboarding time</p></div>
      </div>
    </div>
    <div class="wrap-bleed"><Screens shots={kyc} label="KYC flow screens" /></div>
  </section>

  <section class="decision">
    <div class="wrap d-head">
      <p class="mono d-n">Decision 02</p>
      <h2>Sending crypto without the fear</h2>
      <div class="d-cols" data-reveal>
        <div><h4 class="mono">Insight</h4><p>The riskiest moments were choosing a network and waiting for confirmation, with users guessing at both.</p></div>
        <div><h4 class="mono">Decision</h4><p>Strip the send screen to address and network. Make network choice explicit, with a warning, fees and ETA. Show exactly what lands, what it costs and what’s left before confirming. Replace “pending” with a live timeline.</p></div>
        <div><h4 class="mono">Result</h4><p class="big">+18% trade completion</p></div>
      </div>
    </div>
    <div class="wrap-bleed"><Screens shots={send} label="Send and transaction status screens" /></div>
  </section>

  <section class="decision">
    <div class="wrap d-head">
      <p class="mono d-n">Decision 03</p>
      <h2>Self-serve answers instead of support tickets</h2>
      <div class="d-cols" data-reveal>
        <div><h4 class="mono">Insight</h4><p>Most support tickets were questions the product could answer itself: what’s the rate, is this network right, where’s my transaction?</p></div>
        <div><h4 class="mono">Decision</h4><p>Three small tools: a Rate checker, a Network checker and a Transaction checker, which explains on-chain data in plain language.</p></div>
        <div><h4 class="mono">Result</h4><p class="big">−30% support queries</p></div>
      </div>
    </div>
    <div class="wrap-bleed"><Screens shots={tools} label="Rate, network and transaction checker screens" /></div>
  </section>

  <section class="decision">
    <div class="wrap d-head">
      <p class="mono d-n">Decision 04</p>
      <h2>Qash: local money in and out, without the maths</h2>
      <div class="d-cols" data-reveal>
        <div><h4 class="mono">Insight</h4><p>Converting NGN, GBP or USD into crypto meant leaving the app or doing mental arithmetic, and that’s where trust broke.</p></div>
        <div><h4 class="mono">Decision</h4><p>A native fiat wallet with live rates up front, the total cost before confirmation, and one flow for conversion.</p></div>
        <div><h4 class="mono">Result</h4><p class="big">101,045 transactions in year one</p></div>
      </div>
    </div>
    <div class="wrap duo" data-reveal>
      <Image src={s('qash-1')} alt="Qash onboarding, wallet and exchange screens" widths={[700, 1200]} sizes="(max-width: 800px) 94vw, 46vw" />
      <Image src={s('qash-2')} alt="Qash transaction history and analytics screens" widths={[700, 1200]} sizes="(max-width: 800px) 94vw, 46vw" />
    </div>
  </section>

  <section class="wrap sec">
    <p class="side mono">Also shipped</p>
    <div class="txt" data-reveal>
      <h3 class="also">Roqqu Academy</h3>
      <p>In-app learning paths with short lessons and quizzes for beginner and advanced traders, so people can learn before they risk real money.</p>
    </div>
  </section>
  <div class="wrap duo" data-reveal>
    <Image src={s('academy-1')} alt="Roqqu Academy course list and lesson screens" widths={[700, 1200]} sizes="(max-width: 800px) 94vw, 46vw" />
    <Image src={s('academy-2')} alt="Roqqu Academy quiz and score screens" widths={[700, 1200]} sizes="(max-width: 800px) 94vw, 46vw" />
  </div>


  <div class="wrap part"><p class="mono">Part 2</p><h2>Expanding the <span class="serif">platform</span></h2>
    <p class="part-sub">Once the basics earned trust, the business moved fast into new products. My job was to make each one feel like part of the same calm, trustworthy app, for people who had often never invested, staked or traded futures before.</p>
  </div>

  <section class="decision">
    <div class="wrap d-head">
      <p class="mono d-n">Chapter 05 · Stocks &amp; Commodities</p>
      <h2>Wall Street, from as little as $10</h2>
      <div class="d-cols" data-reveal>
        <div><h4 class="mono">The brief</h4><p>Let users own tokenised US and Nigerian stocks and commodities, 24/7, inside the same app they already trust for crypto.</p></div>
        <div><h4 class="mono">What I designed</h4><p>A mode switcher that keeps Crypto, Qash, Web3 and Stocks separate but one tap apart. An intro that explains tokenised assets and answers the obvious questions (“Do I really own it?”) before the first buy. Fiat-amount buying, stock detail with financials and news, a dividends dashboard and a shareable first-stock milestone.</p></div>
        <div><h4 class="mono">Design principle</h4><p class="big">Explain before you sell</p></div>
      </div>
      <Draft>Co-designed with another designer per the Figma cover. Confirm your share. Any launch metrics (users, volume)?</Draft>
    </div>
    <div class="wrap-bleed"><Screens shots={stocks} label="Stocks and commodities screens" /></div>
  </section>

  <section class="decision">
    <div class="wrap d-head">
      <p class="mono d-n">Chapter 06 · Staking</p>
      <h2>Earning on what you hold, honestly</h2>
      <div class="d-cols" data-reveal>
        <div><h4 class="mono">The brief</h4><p>Non-custodial staking from the Web3 wallet (ETH, SOL, POL and more), with validation by Everstake.</p></div>
        <div><h4 class="mono">What I designed</h4><p>A return calculator before any commitment. A preview that puts APY, payout frequency, unbonding period and fees side by side. A “How it works” that’s upfront about the trade-offs: APY is variable, unbonding takes days, rewards aren’t guaranteed. Every stake state (active, deactivating, withdrawable) is made visible.</p></div>
        <div><h4 class="mono">Design principle</h4><p class="big">Trust comes from the fine print</p></div>
      </div>
      <Draft>Any metrics: total value staked, adoption?</Draft>
    </div>
    <div class="wrap-bleed"><Screens shots={staking} label="Staking screens" /></div>
  </section>

  <section class="decision">
    <div class="wrap d-head">
      <p class="mono d-n">Chapter 07 · AEON</p>
      <h2>AI signals that show their working</h2>
      <div class="d-cols" data-reveal>
        <div><h4 class="mono">The brief</h4><p>AEON scans the market every minute and turns high-probability setups into structured trading signals.</p></div>
        <div><h4 class="mono">What I designed</h4><p>Entry points where traders already are (home, futures, contract detail). A tone of structure over hype. Signals that always show their reasoning: the setup, the indicators, entry, stop loss and take profit. One step from insight to position, with confirmation and an undo.</p></div>
        <div><h4 class="mono">Design principle</h4><p class="big">AI should explain, not just predict</p></div>
      </div>
      <Draft>Any metrics: signal usage, premium conversion?</Draft>
    </div>
    <div class="wrap-bleed"><Screens shots={aeon} label="AEON AI signal screens" /></div>
  </section>

  <section class="decision">
    <div class="wrap d-head">
      <p class="mono d-n">Chapter 08 · Contracts</p>
      <h2>Futures trading, for the rest of us</h2>
      <div class="d-cols" data-reveal>
        <div><h4 class="mono">The brief</h4><p>Perpetual futures on crypto pairs: long or short with leverage. A powerful product, and an easy way to lose money if the design hides the risk.</p></div>
        <div><h4 class="mono">What I designed</h4><p>Guided first-timer onboarding and how-to videos. Margin mode and order types explained in one line each, with the safer option recommended. Liquidation price, margin and fees shown before you commit, and slide-to-confirm instead of a tap. Clear close-trade summaries, shareable P&amp;L cards that double as referrals, and daily trading challenges with leaderboards.</p></div>
        <div><h4 class="mono">Design principle</h4><p class="big">Make risk impossible to miss</p></div>
      </div>
      <Draft>Any metrics: traders, volume, challenge participation?</Draft>
    </div>
    <div class="wrap-bleed"><Screens shots={contracts} label="Contracts futures trading screens" /></div>
  </section>

  <section class="wrap sec">
    <p class="side mono">Results</p>
    <div class="txt" data-reveal>
      <table class="rtable">
        <tbody>
          <tr><th>Onboarding time</th><td>−45%</td></tr>
          <tr><th>Onboarding → first transaction</th><td>+22%</td></tr>
          <tr><th>Successful trade completion</th><td>+18%</td></tr>
          <tr><th>Qash transactions, year one</th><td>101,045</td></tr>
          <tr><th>Support queries</th><td>−30%</td></tr>
          <tr><th>User satisfaction (survey)</th><td>+20%</td></tr>
        </tbody>
      </table>
      <Draft>A one-line quote from a PM or engineer here would make this much stronger.</Draft>
    </div>
  </section>

  <section class="wrap sec">
    <p class="side mono">Reflection</p>
    <div class="txt" data-reveal>
      <p class="lead">If I did it again, I’d instrument the KYC funnel step by step from day one.</p>
      <p>We found the biggest drop-off through interviews first. Earlier event data would have got us there faster. The bigger lesson: in financial products, the most valuable design work is often a status, a warning or a single sentence of reassurance, placed at exactly the right moment.</p>
      <p>Designing Stocks, Staking, AEON and Contracts taught me the other half: as a platform grows, consistency becomes a safety feature. Every new product used the same confirmation patterns, the same way of showing fees and the same honest tone, so that trust carried over.</p>
      <Draft>Draft reflection. Edit it so it sounds like you.</Draft>
    </div>
  </section>
</Case>
