---
import Base from '../layouts/Base.astro';
import Loader from '../components/Loader.astro';
import Terminal from '../components/Terminal.astro';
import WorkGrid from '../components/WorkGrid.astro';

const statement = 'I make money feel simple. For six years I’ve designed the moments where people trust a product with their savings, their salary and their business.';
const experience = [
  ['2023 — now', 'Roqqu', 'Senior Product Designer', '+22% activation'],
  ['2023 — 2026', 'EN1', 'Senior Product Designer · Contract', '+15% team velocity'],
  ['2022 — 2023', 'Glover', 'Senior Product Designer', '+30% revenue'],
  ['2021 — 2023', 'Clink', 'Co-founder & Product Designer', '+20% conversion'],
  ['2021 — 2022', 'STEMuli · US', 'Product Designer', '+25% retention'],
  ['2019 — 2023', 'Sterling Bank · Edubanc', 'Product Designer', '₦45M+ processed'],
];
const email = 'thosynlasisi@gmail.com';
---
<Base>
  <Loader />

  <header class="nav wrap">
    <a href="/" class="logo"><span class="dot"></span>Tosin Lasisi</a>
    <nav aria-label="Main">
      <a href="#work">Work</a>
      <a href="/about">About</a>
      <a href="/Tosin_Lasisi_CV.pdf">CV</a>
      <button class="theme-btn" onclick="window.__toggleTheme && window.__toggleTheme()" aria-label="Switch light or dark theme"><svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2.2"><circle cx="12" cy="12" r="8"/><path d="M12 4a8 8 0 0 1 0 16z" fill="currentColor"/></svg></button>
      <a class="cta" href={`mailto:${email}`}>Get in touch</a>
    </nav>
  </header>

  <main>
    <!-- HERO -->
    <section class="hero wrap">
      <div class="hero-copy">
        <p class="mono eyebrow"><span class="live"></span> Open to senior &amp; lead roles</p>
        <h1>I design <span class="serif">financial</span> products people trust with their money.</h1>
        <p class="sub">Senior Product Designer with 6+ years across crypto, fintech and platforms in Africa and beyond. I take products from first discovery to launch, and measure the result.</p>
        <div class="hero-ctas">
          <a class="btn btn-solid" href="#work">See the work ↓</a>
          <a class="btn" href={`mailto:${email}`}>Get in touch</a>
        </div>
        <p class="mono muted meta">Lagos, NG · <span id="lagos-time">—</span> WAT</p>
      </div>
      <div class="hero-object">
        <Terminal />
      </div>
    </section>

    <WorkGrid />

    <!-- STATEMENT: words light up as you scroll (ref: HUMAN.md) -->
    <section class="statement wrap" aria-label="About">
      <p class="mono muted">How I work</p>
      <p class="big" id="statement">
        {statement.split(' ').map(w => <span>{w} </span>)}
      </p>
      <div class="principles">
        <div><h3>Problem first</h3><p>Discovery before design: research, journey maps and problem-framing workshops, so the team agrees on <em>why</em> before arguing about <em>what</em>.</p></div>
        <div><h3>High-stakes clarity</h3><p>KYC, transfers, irreversible actions. I design these moments for nervous users, because that’s where trust is won or lost.</p></div>
        <div><h3>Systems, not screens</h3><p>Design systems and patterns that let teams ship faster, from EN1’s first system to Roqqu’s trading surfaces.</p></div>
        <div><h3>Measured</h3><p>Success metrics agreed up front, usability tests before launch, data after.</p></div>
      </div>
    </section>

    <!-- EXPERIENCE (ref: Ethan Kinnan list) -->
    <section class="exp wrap" aria-labelledby="exp-title">
      <h2 id="exp-title" class="mono muted">Experience</h2>
      <ol role="list">
        {experience.map(([y, c, r, m]) => (
          <li><span class="mono muted">{y}</span><strong>{c}</strong><span class="muted">{r}</span><span class="m">{m}</span></li>
        ))}
      </ol>
    </section>

    <!-- CONTACT -->
    <section class="contact wrap">
      <p class="mono muted">Next transaction</p>
      <h2>Hiring a senior <span class="serif">product designer?</span></h2>
      <p class="sub">I’m looking for my next full-time role on a team building products people rely on.</p>
      <div class="hero-ctas">
        <a class="btn btn-solid btn-xl" href={`mailto:${email}`}>{email}</a>
        <a class="btn" href="https://www.linkedin.com/in/tosin-ridwan-lasisi/" rel="noopener">LinkedIn ↗</a>
        <a class="btn" href="/Tosin_Lasisi_CV.pdf">Download CV</a>
      </div>
    </section>
  </main>

  <footer class="foot wrap mono muted">
    <span>© 2026 Tosin Lasisi</span><span>Designed by me · Built with Astro</span>
  </footer>
</Base>

<script is:inline>
  // Lagos clock
  const lt = document.getElementById('lagos-time');
  const tick = () => lt.textContent = new Date().toLocaleTimeString('en-GB', { hour: '2-digit', minute: '2-digit', timeZone: 'Africa/Lagos' });
  tick(); setInterval(tick, 30000);

  // Statement: light words up as it scrolls through the viewport
  const words = [...document.querySelectorAll('#statement span')];
  const st = document.getElementById('statement');
  const onScroll = () => {
    const r = st.getBoundingClientRect();
    const k = Math.min(1, Math.max(0, (innerHeight * .85 - r.top) / (r.height + innerHeight * .35)));
    const n = Math.round(k * words.length);
    words.forEach((w, i) => w.classList.toggle('lit', i < n));
  };
  if (matchMedia('(prefers-reduced-motion: reduce)').matches) words.forEach(w => w.classList.add('lit'));
  else { addEventListener('scroll', onScroll, { passive: true }); onScroll(); }
</script>

<style>
  .nav { position: sticky; top: 0; z-index: 20; display: flex; justify-content: space-between; align-items: center; height: 68px; background: color-mix(in oklab, var(--bg) 82%, transparent); backdrop-filter: blur(12px); }
  .logo { display: inline-flex; align-items: center; gap: 9px; font-weight: 700; letter-spacing: -.02em; text-decoration: none; font-size: 18px; }
  .dot { width: 12px; height: 12px; border-radius: 50%; background: var(--coin); box-shadow: 0 0 0 3px color-mix(in oklab, var(--coin) 25%, transparent); }
  .nav nav { display: flex; align-items: center; gap: clamp(12px, 2.4vw, 28px); font-size: 15px; }
  .nav nav a { text-decoration: none; }
  .nav nav a:not(.cta):hover { text-decoration: underline; text-underline-offset: 4px; }
  .theme-btn { display: grid; place-items: center; appearance: none; background: none; border: 1.5px solid var(--line-strong); color: var(--text); width: 32px; height: 32px; border-radius: 50%; cursor: pointer; font-size: 15px; }
  .cta { background: var(--text); color: var(--bg); padding: 9px 16px; border-radius: 99px; font-weight: 600; }
  @media (max-width: 640px) { .nav nav a:not(.cta) { display: none; } }

  .hero { display: grid; grid-template-columns: 1.05fr 1fr; align-items: center; gap: 40px; min-height: calc(100svh - 68px); padding-block: 24px 56px; }
  .eyebrow { display: inline-flex; align-items: center; gap: 8px; border: 1.5px solid var(--line); border-radius: 99px; padding: 6px 12px; margin: 0 0 28px; }
  .live { width: 8px; height: 8px; border-radius: 50%; background: #2fb36a; box-shadow: 0 0 0 0 #2fb36a88; animation: ping 2s infinite; }
  @keyframes ping { 70% { box-shadow: 0 0 0 8px #2fb36a00 } 100% { box-shadow: 0 0 0 0 #2fb36a00 } }
  h1 { margin: 0; font-size: clamp(44px, 6.2vw, 96px); line-height: .95; letter-spacing: -.055em; font-weight: 800; max-width: 11ch; }
  h1 .serif { font-weight: 400; letter-spacing: -.025em; color: var(--w-roqqu); }
  .sub { font-size: clamp(17px, 1.4vw, 20px); max-width: 46ch; color: var(--muted); margin: 26px 0 30px; }
  .hero-ctas { display: flex; gap: 12px; flex-wrap: wrap; }
  .btn { display: inline-flex; align-items: center; height: 50px; padding: 0 22px; border-radius: 99px; border: 1.5px solid var(--line-strong); text-decoration: none; font-weight: 600; transition: transform .2s var(--ease), background .2s; }
  .btn:hover { transform: translateY(-2px); }
  .btn-solid { background: var(--text); color: var(--bg); border-color: var(--text); }
  .btn-xl { height: 60px; font-size: 18px; padding: 0 28px; }
  .meta { margin-top: 36px; }
  @media (max-width: 900px) {
    .hero { grid-template-columns: 1fr; min-height: auto; padding-top: 32px; }
    .hero-object { order: 2; }
  }

  .statement { padding-block: clamp(80px, 12vw, 180px); }
  .big { font-size: clamp(32px, 4.6vw, 72px); line-height: 1.05; letter-spacing: -.045em; font-weight: 700; margin: 18px 0 72px; max-width: 22ch; }
  .big span { color: color-mix(in oklab, var(--text) 18%, var(--bg)); transition: color .35s var(--ease); }
  .big span.lit { color: var(--text); }
  .principles { display: grid; grid-template-columns: repeat(4, 1fr); gap: 28px; border-top: 1.5px solid var(--line); padding-top: 28px; }
  .principles h3 { margin: 0 0 8px; font-size: 20px; letter-spacing: -.02em; }
  .principles p { margin: 0; color: var(--muted); font-size: 15.5px; }
  .principles em { font-family: var(--f-serif); font-size: 1.15em; color: var(--text); }
  @media (max-width: 900px) { .principles { grid-template-columns: 1fr 1fr; } }
  @media (max-width: 560px) { .principles { grid-template-columns: 1fr; } }

  .exp { padding-bottom: clamp(80px, 10vw, 140px); }
  .exp h2 { font-weight: 400; margin: 0 0 12px; }
  .exp ol { list-style: none; margin: 0; padding: 0; }
  .exp li { display: grid; grid-template-columns: 150px 1fr 1fr auto; gap: 16px; align-items: baseline; padding: 18px 0; border-top: 1.5px solid var(--line); font-size: 18px; transition: padding .3s var(--ease); }
  .exp li:last-child { border-bottom: 1.5px solid var(--line); }
  .exp li:hover { padding-left: 10px; }
  .exp .m { font-family: var(--f-mono); font-size: 13px; background: color-mix(in oklab, var(--coin) 22%, transparent); padding: 3px 8px; border-radius: 6px; }
  @media (max-width: 760px) { .exp li { grid-template-columns: 1fr auto; } .exp li > span:first-child { grid-column: 1 / -1; } .exp li > span.muted:not(.mono) { display: none; } }

  .contact { padding-block: clamp(80px, 12vw, 160px); border-top: 1.5px solid var(--line); }
  .contact h2 { font-size: clamp(44px, 7.5vw, 120px); line-height: .92; letter-spacing: -.055em; margin: 16px 0 0; font-weight: 800; max-width: 12ch; }
  .contact .serif { font-weight: 400; color: var(--w-glover); }
  .foot { display: flex; justify-content: space-between; padding-block: 28px; border-top: 1.5px solid var(--line); flex-wrap: wrap; gap: 8px; }
</style>
