---
import Base from '../layouts/Base.astro';
import Loader from '../components/Loader.astro';
import Terminal from '../components/Terminal.astro';
import WorkGrid from '../components/WorkGrid.astro';
import Nav from '../components/Nav.astro';
import Experience from '../components/Experience.astro';
import Contact from '../components/Contact.astro';
import Testimonials from '../components/Testimonials.astro';
import { site } from '../data/site';

const statement = 'I make money feel simple. For six years I’ve designed the moments where people trust a product with their savings, their salary and their business.';
const email = site.email;
---
<Base>
  <Loader />

  <Nav />

  <main id="main">
    <!-- HERO -->
    <section class="hero wrap">
      <div class="hero-copy">
        <p class="mono eyebrow"><span class="live"></span> Open to senior &amp; lead roles</p>
        <h1>I design how <span class="serif">money</span> moves.</h1>
        <p class="sub">Senior Product Designer with 6+ years across crypto, fintech and platforms in Africa and beyond. I take products from first discovery to launch, test ideas in real builds, and measure the result.</p>
        <div class="hero-ctas">
          <a class="btn btn-solid" href="#work">See the work ↓</a>
          <a class="btn" href={`mailto:${email}`}>Get in touch</a>
        </div>
        <p class="mono muted meta">Lagos, NG · <span id="lagos-time">—</span> WAT</p>
      </div>
      <div class="hero-object">
        <Terminal />
      </div>
    </section>

    <WorkGrid />

    <!-- STATEMENT: words light up as you scroll (ref: HUMAN.md) -->
    <section class="statement wrap" aria-label="About">
      <p class="mono muted">How I work</p>
      <p class="big" id="statement">
        {statement.split(' ').map(w => <span>{w} </span>)}
      </p>
      <div class="principles" data-reveal>
        <div><h3>Problem first</h3><p>Discovery before design: research, journey maps and problem-framing workshops, so the team agrees on <em>why</em> before arguing about <em>what</em>.</p></div>
        <div><h3>High-stakes clarity</h3><p>KYC, transfers, irreversible actions. I design these moments for nervous users, because that’s where trust is won or lost.</p></div>
        <div><h3>Systems, not screens</h3><p>Design systems and patterns that let teams ship faster, from EN1’s first system to Roqqu’s trading surfaces.</p></div>
        <div><h3>Measured</h3><p>Success metrics agreed up front, usability tests before launch, data after.</p></div>
      </div>
    </section>

    <Testimonials />
    <Experience />

    <Contact />
  </main>
</Base>

<script is:inline>
  // Lagos clock
  const lt = document.getElementById('lagos-time');
  const tick = () => lt.textContent = new Date().toLocaleTimeString('en-GB', { hour: '2-digit', minute: '2-digit', timeZone: 'Africa/Lagos' });
  tick(); setInterval(tick, 30000);

  // Statement: light words up as it scrolls through the viewport
  const words = [...document.querySelectorAll('#statement span')];
  const st = document.getElementById('statement');
  const onScroll = () => {
    const r = st.getBoundingClientRect();
    const k = Math.min(1, Math.max(0, (innerHeight * .85 - r.top) / (r.height + innerHeight * .35)));
    const n = Math.round(k * words.length);
    words.forEach((w, i) => w.classList.toggle('lit', i < n));
  };
  if (matchMedia('(prefers-reduced-motion: reduce)').matches) words.forEach(w => w.classList.add('lit'));
  else { addEventListener('scroll', onScroll, { passive: true }); onScroll(); }
</script>

<style>
  .hero { display: grid; grid-template-columns: 1.05fr 1fr; align-items: center; gap: 40px; min-height: calc(100svh - 68px); padding-block: 24px 40px; }
  .eyebrow { display: inline-flex; align-items: center; gap: 8px; border: 1.5px solid var(--line); border-radius: 99px; padding: 6px 12px; margin: 0 0 28px; }
  .live { width: 8px; height: 8px; border-radius: 50%; background: #2fb36a; box-shadow: 0 0 0 0 #2fb36a88; animation: ping 2s infinite; }
  @keyframes ping { 70% { box-shadow: 0 0 0 8px #2fb36a00 } 100% { box-shadow: 0 0 0 0 #2fb36a00 } }
  h1 { margin: 0; font-size: clamp(44px, 6.2vw, 96px); line-height: .95; letter-spacing: -.055em; font-weight: 800; max-width: 11ch; }
  h1 .serif { font-weight: 400; letter-spacing: -.025em; color: var(--accent-text); }
  .sub { font-size: clamp(17px, 1.4vw, 20px); max-width: 46ch; color: var(--muted); margin: 26px 0 30px; }
  .hero-ctas { display: flex; gap: 12px; flex-wrap: wrap; }
  .meta { margin-top: 36px; }
  @media (max-width: 900px) { .meta { margin: 24px 0 0; } }
  @media (max-width: 900px) {
    .hero { grid-template-columns: 1fr; min-height: auto; padding-top: 32px; gap: 8px; }
    .hero-object { order: 2; }
  }

  :global(.exp) { border-top: 1.5px solid var(--line); padding-top: clamp(56px, 8vw, 110px); }
  .statement { padding-block: clamp(72px, 10vw, 140px); }
  .big { font-size: clamp(32px, 4.6vw, 72px); line-height: 1.05; letter-spacing: -.045em; font-weight: 700; margin: 18px 0 clamp(40px, 5vw, 72px); max-width: 22ch; }
  .big span { color: color-mix(in oklab, var(--text) 18%, var(--bg)); transition: color .35s var(--ease); }
  .big span.lit { color: var(--text); }
  .principles { display: grid; grid-template-columns: repeat(4, 1fr); gap: 28px; border-top: 1.5px solid var(--line); padding-top: 28px; }
  .principles h3 { margin: 0 0 8px; font-size: 20px; letter-spacing: -.02em; }
  .principles p { margin: 0; color: var(--muted); font-size: 15.5px; }
  .principles em { font-family: var(--f-serif); font-size: 1.15em; color: var(--text); }
  @media (max-width: 900px) { .principles { grid-template-columns: 1fr 1fr; } }
  @media (max-width: 560px) { .principles { grid-template-columns: 1fr; } }

</style>
