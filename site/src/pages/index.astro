---
import Base from '../layouts/Base.astro';
import Loader from '../components/Loader.astro';
import Terminal from '../components/Terminal.astro';
import WorkGrid from '../components/WorkGrid.astro';
import Nav from '../components/Nav.astro';
import Experience from '../components/Experience.astro';
import Contact from '../components/Contact.astro';
import { site } from '../data/site';

const email = site.email;
---
<Base>
  <script is:inline>
    (function () {
      const q = new URLSearchParams(location.search);
      try {
        if (q.has('list')) { localStorage.setItem('homeMode', 'list'); history.replaceState(null, '', '/' + location.hash); return; }
        if (localStorage.getItem('homeMode') === 'canvas' && matchMedia('(min-width: 801px)').matches && !location.hash) location.replace('/canvas');
      } catch {}
    })();
  </script>
  <Loader />

  <Nav />

  <main id="main">
    <!-- HERO -->
    <section class="hero wrap">
      <div class="hero-copy">
        <p class="label eyebrow"><span class="live"></span> Open to senior &amp; lead roles</p>
        <h1>I design how <span class="serif">money</span> moves.</h1>
        <p class="sub">Senior Product Designer with 6+ years across crypto, fintech and platforms in Africa and beyond. I take products from first discovery to launch, test ideas in real builds, and measure the result.</p>
        <div class="hero-ctas">
          <a class="btn btn-solid" href="#work">See the work ↓</a>
          <a class="btn" href={`mailto:${email}`}>Get in touch</a>
        </div>
        <p class="mono muted meta">Lagos, NG · <span id="lagos-time">—</span> WAT</p>
      </div>
      <div class="hero-object">
        <Terminal />
      </div>
    </section>

    <WorkGrid />

    <Experience />

    <Contact />
  </main>
</Base>

<script is:inline>
  // Lagos clock
  const lt = document.getElementById('lagos-time');
  const tick = () => lt.textContent = new Date().toLocaleTimeString('en-GB', { hour: '2-digit', minute: '2-digit', timeZone: 'Africa/Lagos' });
  tick(); setInterval(tick, 30000);

</script>

<style>
  .hero { display: grid; grid-template-columns: 1.05fr 1fr; align-items: center; gap: 40px; min-height: calc(100svh - 68px); padding-block: 24px 40px; }
  .eyebrow { display: inline-flex; align-items: center; gap: 8px; border: 1.5px solid var(--line); border-radius: 99px; padding: 6px 12px; margin: 0 0 28px; }
  .live { width: 8px; height: 8px; border-radius: 50%; background: #2fb36a; box-shadow: 0 0 0 0 #2fb36a88; animation: ping 2s infinite; }
  @keyframes ping { 70% { box-shadow: 0 0 0 8px #2fb36a00 } 100% { box-shadow: 0 0 0 0 #2fb36a00 } }
  h1 { margin: 0; font-size: clamp(44px, 6.2vw, 96px); line-height: .95; letter-spacing: -.055em; font-weight: 800; max-width: 11ch; }
  h1 .serif { font-weight: 400; letter-spacing: -.025em; color: var(--accent-text); }
  .sub { font-size: clamp(17px, 1.4vw, 20px); max-width: 46ch; color: var(--muted); margin: 26px 0 30px; }
  .hero-ctas { display: flex; gap: 12px; flex-wrap: wrap; }
  .meta { margin-top: 36px; }
  @media (max-width: 900px) { .meta { margin: 24px 0 0; } }
  @media (max-width: 900px) {
    .hero { grid-template-columns: 1fr; min-height: auto; padding-top: 32px; gap: 8px; }
    .hero-object { order: 2; }
  }

  :global(.exp) { padding-top: var(--section); }

</style>
