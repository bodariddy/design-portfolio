---
import { site } from '../data/site';
const path = Astro.url.pathname;
const links = [
  { href: '/#work', label: 'Work', match: '/work' },
  { href: '/about', label: 'About', match: '/about' },
  { href: site.cv, label: 'CV', match: '' },
];
---
<header class="nav wrap">
  <a href="/" class="logo"><span class="dot"></span>{site.name}</a>
  <nav aria-label="Main">
    {links.map(l => <a href={l.href} aria-current={l.match && path.startsWith(l.match) ? 'page' : undefined}>{l.label}</a>)}
    <button class="theme-btn" data-theme-toggle aria-label="Switch light or dark theme">
      <svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2.2"><circle cx="12" cy="12" r="8"/><path d="M12 4a8 8 0 0 1 0 16z" fill="currentColor"/></svg>
    </button>
    <a class="cta" href={`mailto:${site.email}`}>Get in touch</a>
  </nav>
</header>

<style>
  .nav { position: sticky; top: 0; z-index: 20; display: flex; justify-content: space-between; align-items: center; height: 68px; background: color-mix(in oklab, var(--bg) 82%, transparent); backdrop-filter: blur(12px); -webkit-backdrop-filter: blur(12px); }
  .logo { display: inline-flex; align-items: center; gap: 9px; font-weight: 700; letter-spacing: -.02em; text-decoration: none; font-size: 18px; }
  .dot { width: 12px; height: 12px; border-radius: 50%; background: var(--coin); box-shadow: 0 0 0 3px color-mix(in oklab, var(--coin) 25%, transparent); }
  nav { display: flex; align-items: center; gap: clamp(12px, 2.4vw, 28px); font-size: 15px; }
  nav a { text-decoration: none; }
  nav a:not(.cta):hover, nav a[aria-current='page'] { text-decoration: underline; text-underline-offset: 5px; text-decoration-thickness: 1.5px; }
  .theme-btn { display: grid; place-items: center; appearance: none; background: none; border: 1.5px solid var(--line-strong); color: var(--text); width: 32px; height: 32px; border-radius: 50%; cursor: pointer; transition: transform .4s var(--ease); }
  .theme-btn:hover { transform: rotate(180deg); }
  .cta { background: var(--text); color: var(--bg); padding: 9px 16px; border-radius: 99px; font-weight: 600; }
  @media (max-width: 640px) { nav a:not(.cta) { display: none; } }
</style>
