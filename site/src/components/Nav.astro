---
// Minimal bar (logo · theme · Get in touch · Menu). All links live in a full-screen menu.
import { site } from '../data/site';
import { featured } from '../data/projects';
const path = Astro.url.pathname;
const links = [
  { href: '/', label: 'Home', match: '/' },
  { href: '/#work', label: 'Work', match: '/work' },
  { href: '/about', label: 'About', match: '/about' },
  { href: site.cv, label: 'CV', match: '' },
];
const homeMode = path === '/' || path.startsWith('/canvas') ? (path.startsWith('/canvas') ? 'canvas' : 'list') : null;
const isCurrent = (m: string) => m && (m === '/' ? path === '/' : path.startsWith(m));
---
<header class="nav" id="nav">
  <div class="wrap bar">
    <a href="/" class="logo" aria-label={`${site.name}, home`}><span class="dot"></span>{site.name}</a>
    <div class="actions">
      {homeMode && (
        <div class="mode" role="group" aria-label="View mode">
          <a href="/?list" data-mode="list" aria-label="List view" title="List view" aria-current={homeMode === 'list' ? 'true' : undefined}>
            <svg viewBox="0 0 16 16" width="14" height="14" aria-hidden="true"><path d="M2 4h12M2 8h12M2 12h12" stroke="currentColor" stroke-width="1.6" fill="none" stroke-linecap="round"/></svg>
          </a>
          <a href="/canvas" data-mode="canvas" aria-label="Canvas view" title="Canvas view" aria-current={homeMode === 'canvas' ? 'true' : undefined}>
            <svg viewBox="0 0 16 16" width="14" height="14" aria-hidden="true"><rect x="2" y="2" width="5" height="5" rx="1" stroke="currentColor" stroke-width="1.5" fill="none"/><rect x="9" y="4" width="5" height="4" rx="1" stroke="currentColor" stroke-width="1.5" fill="none"/><rect x="4" y="9" width="6" height="5" rx="1" stroke="currentColor" stroke-width="1.5" fill="none"/></svg>
          </a>
          <span class="mode-nudge mono" id="mode-nudge" hidden>New · explore my work as a canvas <b aria-hidden="true">↑</b></span>
        </div>
      )}
      <button class="icon-btn" data-theme-toggle aria-label="Switch light or dark theme">
        <svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2.2"><circle cx="12" cy="12" r="8"/><path d="M12 4a8 8 0 0 1 0 16z" fill="currentColor"/></svg>
      </button>
      <button class="menu-btn" id="menu-btn" aria-expanded="false" aria-controls="menu" aria-label="Open menu">
        <span class="mb-label mono"><span class="t-open">Menu</span><span class="t-close">Close</span></span>
        <span class="bars" aria-hidden="true"><i></i><i></i></span>
      </button>
    </div>
  </div>

  <div class="menu" id="menu" hidden>
    <div class="wrap menu-inner">
      <nav class="m-main" aria-label="Main">
        <ul role="list">
          {links.map((l, i) => (
            <li style={`--i:${i}`}>
              <a href={l.href} aria-current={isCurrent(l.match) ? 'page' : undefined}>
                <span class="mono n">0{i + 1}</span><span class="lbl">{l.label}</span><span class="arr" aria-hidden="true">→</span>
              </a>
            </li>
          ))}
        </ul>
        <a class="m-canvas mono" href="/canvas" data-mode="canvas">⊞ View as canvas</a>
      </nav>

      <aside class="m-side">
        <div class="m-block" style="--i:4">
          <p class="mono muted">Featured work</p>
          <ul role="list" class="m-work">
            {featured.map(p => (
              <li><a href={`/work/${p.slug}`} style={`--world: var(${p.colour})`}><i></i>{p.name}<span class="mono muted">{p.years}</span></a></li>
            ))}
          </ul>
        </div>
        <div class="m-block" style="--i:5">
          <p class="mono muted">Contact</p>
          <a class="m-cta" href={`mailto:${site.email}`}>Get in touch →</a>
          <a class="m-mail" href={`mailto:${site.email}`}>{site.email}</a>
          <a href={site.linkedin} rel="noopener">LinkedIn ↗</a>
        </div>
        <p class="mono muted m-time" style="--i:6"><span data-lagos-clock>—</span> in Lagos · Open to senior roles</p>
      </aside>
    </div>
  </div>
</header>

<script is:inline>
  (function () {
    const nav = document.getElementById('nav'), btn = document.getElementById('menu-btn'), menu = document.getElementById('menu');
    let last = scrollY;
    addEventListener('scroll', () => {
      const y = scrollY;
      nav.classList.toggle('scrolled', y > 8);
      if (!nav.classList.contains('open')) nav.classList.toggle('hide', y > last && y > 240);
      last = y;
    }, { passive: true });
    const set = open => {
      nav.classList.toggle('open', open); btn.setAttribute('aria-expanded', open); btn.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
      if (open) { menu.hidden = false; requestAnimationFrame(() => menu.classList.add('show')); document.body.style.overflow = 'hidden'; menu.querySelector('a').focus({ preventScroll: true }); }
      else { menu.classList.remove('show'); document.body.style.overflow = ''; setTimeout(() => { if (!nav.classList.contains('open')) menu.hidden = true; }, 500); }
    };
    btn.addEventListener('click', () => set(!nav.classList.contains('open')));
    menu.addEventListener('click', e => { if (e.target.closest('a')) set(false); });
    addEventListener('keydown', e => { if (e.key === 'Escape' && nav.classList.contains('open')) { set(false); btn.focus(); } });
    // View mode: remember the visitor's choice
    document.querySelectorAll('[data-mode]').forEach(a => a.addEventListener('click', () => { try { localStorage.setItem('homeMode', a.dataset.mode); } catch {} }));
    // One-time nudge on the list homepage, after the intro
    const nudge = document.getElementById('mode-nudge');
    if (nudge && location.pathname === '/' && matchMedia('(min-width: 801px)').matches) {
      let seen = false; try { seen = localStorage.getItem('modeNudge') === '1'; } catch {}
      if (!seen) {
        const show = () => { nudge.hidden = false; requestAnimationFrame(() => nudge.classList.add('on')); try { localStorage.setItem('modeNudge', '1'); } catch {}
          setTimeout(() => { nudge.classList.remove('on'); setTimeout(() => nudge.hidden = true, 500); }, 7000); };
        setTimeout(show, document.documentElement.classList.contains('is-loading') ? 3000 : 900);
      }
    }
    // Lagos clock (shared attribute with the footer)
    const els = document.querySelectorAll('[data-lagos-clock]');
    if (els.length) { const f = new Intl.DateTimeFormat('en-GB', { hour: 'numeric', minute: '2-digit', second: '2-digit', hour12: true, timeZone: 'Africa/Lagos' });
      const t = () => { const v = f.format(new Date()).replace(' ', '').toLowerCase(); els.forEach(e => e.textContent = v); }; t(); setInterval(t, 1000); }
  })();
</script>

<style>
  .nav { position: sticky; top: 0; z-index: 50; transition: transform .45s var(--ease); }
  .nav::before { content: ''; position: absolute; inset: 0; z-index: 0; opacity: 0; transition: opacity .3s; background: color-mix(in oklab, var(--bg) 84%, transparent); backdrop-filter: blur(14px) saturate(1.2); -webkit-backdrop-filter: blur(14px) saturate(1.2); box-shadow: 0 1px 0 var(--line); }
  .nav.scrolled::before { opacity: 1; }
  .nav.open::before { opacity: 0; }
  .nav.hide { transform: translateY(-100%); }
  .bar { position: relative; z-index: 2; display: flex; justify-content: space-between; align-items: center; height: 68px; }
  .logo { display: inline-flex; align-items: center; gap: 9px; font-weight: 700; letter-spacing: -.02em; text-decoration: none; font-size: 18px; }
  .dot { width: 12px; height: 12px; border-radius: 50%; background: var(--coin); box-shadow: 0 0 0 3px color-mix(in oklab, var(--coin) 25%, transparent); transition: transform .4s var(--ease); }
  .logo:hover .dot { transform: translateY(-3px); }
  .actions { display: flex; align-items: center; gap: 10px; }
  .icon-btn { display: grid; place-items: center; appearance: none; background: none; border: 1.5px solid var(--line-strong); color: var(--text); width: 38px; height: 38px; border-radius: 50%; cursor: pointer; transition: transform .4s var(--ease), background .2s; }
  .icon-btn:hover { background: color-mix(in oklab, var(--text) 6%, transparent); transform: rotate(180deg); }

  .menu-btn { appearance: none; display: inline-flex; align-items: center; gap: 10px; height: 38px; padding: 0 8px 0 14px; border-radius: 99px; border: 1.5px solid var(--line-strong); background: color-mix(in oklab, var(--bg) 70%, transparent); color: var(--text); cursor: pointer; transition: background .2s; }
  .menu-btn:hover { background: color-mix(in oklab, var(--text) 6%, transparent); }
  .mb-label { position: relative; height: 14px; overflow: hidden; display: grid; }
  .mb-label > span { grid-area: 1 / 1; transition: transform .4s var(--ease); }
  .t-close { transform: translateY(110%); }
  .open .t-open { transform: translateY(-110%); } .open .t-close { transform: none; }
  .bars { width: 24px; height: 24px; border-radius: 50%; background: var(--text); display: grid; place-content: center; gap: 3px; }
  .bars i { display: block; width: 10px; height: 1.5px; background: var(--bg); transition: transform .4s var(--ease); }
  .open .bars i:first-child { transform: translateY(2.25px) rotate(45deg); }
  .open .bars i:last-child { transform: translateY(-2.25px) rotate(-45deg); }

  /* Full-screen menu */
  .menu { position: fixed; inset: 0; z-index: 1; background: var(--bg); overflow-y: auto; clip-path: inset(0 0 100% 0); transition: clip-path .6s var(--ease); }
  .menu.show { clip-path: inset(0 0 0 0); }
  .menu-inner { min-height: 100%; display: grid; grid-template-columns: 1.6fr 1fr; gap: clamp(32px, 6vw, 96px); padding-top: clamp(100px, 14vh, 150px); padding-bottom: 40px; }
  .m-main ul, .m-work { list-style: none; margin: 0; padding: 0; }
  .m-main li, .m-block, .m-time { opacity: 0; transform: translateY(18px); transition: opacity .5s var(--ease), transform .6s var(--ease); transition-delay: calc(var(--i) * 60ms + 150ms); }
  .menu.show .m-main li, .menu.show .m-block, .menu.show .m-time { opacity: 1; transform: none; }
  .m-main li { border-top: 1.5px solid var(--line); }
  .m-main li:last-child { border-bottom: 1.5px solid var(--line); }
  .m-main a { display: grid; grid-template-columns: 52px 1fr auto; align-items: baseline; padding: clamp(10px, 1.4vw, 18px) 0; text-decoration: none; }
  .m-main .n { color: var(--muted); }
  .m-main .lbl { font-size: clamp(44px, 7.5vw, 112px); font-weight: 800; letter-spacing: -.055em; line-height: .95; transition: transform .45s var(--ease), color .3s; }
  .m-main .arr { font-size: clamp(24px, 3vw, 44px); opacity: 0; transform: translateX(-12px); transition: opacity .3s, transform .45s var(--ease); }
  .m-main a:hover .lbl { transform: translateX(14px); }
  .m-main a:hover .arr { opacity: 1; transform: none; }
  .m-main a[aria-current='page'] .lbl::after { content: ''; display: inline-block; width: .16em; height: .16em; margin-left: .12em; border-radius: 50%; background: var(--coin); vertical-align: .55em; }

  .m-side { display: flex; flex-direction: column; gap: 36px; padding-top: 10px; }
  .m-block { display: grid; gap: 8px; }
  .m-block .mono { margin: 0 0 6px; }
  .m-work a { display: flex; align-items: center; gap: 10px; padding: 7px 0; text-decoration: none; font-size: 19px; letter-spacing: -.02em; transition: padding .3s var(--ease); }
  .m-work a:hover { padding-left: 8px; }
  .m-work i { width: 9px; height: 9px; border-radius: 50%; background: var(--world); }
  .m-work .mono { margin-left: auto; font-size: 11px; }
  .m-block > a { font-size: 17px; text-decoration: none; }
  .m-block > a.m-cta { justify-self: start; background: var(--text); color: var(--bg); padding: 12px 20px; border-radius: 99px; font-weight: 600; margin-bottom: 6px; }
  .m-mail { font-size: clamp(20px, 1.8vw, 26px) !important; font-weight: 600; letter-spacing: -.02em; text-decoration: underline !important; text-decoration-color: var(--coin) !important; text-underline-offset: 5px; }
  .m-time { margin: auto 0 0; font-variant-numeric: tabular-nums; }

  .mode { position: relative; display: inline-flex; padding: 3px; border-radius: 99px; border: 1.5px solid var(--line-strong); background: color-mix(in oklab, var(--bg) 70%, transparent); }
  .mode a { display: inline-grid; place-items: center; width: 32px; height: 28px; padding: 0; border-radius: 99px; font-size: 13.5px; font-weight: 600; text-decoration: none; color: var(--muted); transition: background .25s, color .25s; }
  .mode a:hover { color: var(--text); }
  .mode a[aria-current] { background: var(--text); color: var(--bg); }
  .mode-nudge { position: absolute; top: calc(100% + 12px); right: 0; white-space: nowrap; padding: 8px 12px; border-radius: 10px; background: var(--coin); color: #171614; font-size: 11px; box-shadow: 0 10px 24px -10px rgba(0,0,0,.35); opacity: 0; transform: translateY(-6px); transition: opacity .4s, transform .5s var(--ease); pointer-events: none; }
  .mode-nudge::before { content: ''; position: absolute; top: -5px; right: 13px; width: 10px; height: 10px; background: var(--coin); transform: rotate(45deg); }
  .mode-nudge b { display: none; }
  .mode-nudge.on { opacity: 1; transform: none; }
  .open .mode-nudge { opacity: 0 !important; }
  .m-main a.m-canvas { display: none; grid-template-columns: none; align-items: center; gap: 8px; margin-top: 20px; padding: 11px 16px; border-radius: 99px; border: 1.5px solid var(--line-strong); width: max-content; white-space: nowrap; font-size: 12px; }
  @media (max-width: 800px) {
    .mode { display: none; }
    .m-main a.m-canvas { display: inline-flex; }
    .menu-inner { grid-template-columns: 1fr; padding-top: 96px; }
    .m-main a { grid-template-columns: 40px 1fr auto; }
  }
  @media (prefers-reduced-motion: reduce) { .menu { transition: none; } }
</style>
