---
import { featured as projects, hasPage } from '../data/projects';
const receiptData = JSON.stringify(projects.map(p => ({ ch: p.ch, name: p.name, slug: p.slug, headline: p.headline, receipt: p.receipt, page: hasPage(p.slug) })));
---
<div class="pos-wrap" data-ch="1" id="pos">
  <!-- Receipt prints up out of the slot -->
  <div class="receipt-clip" aria-hidden="true">
    <div class="receipt" id="receipt">
      <div class="r-head">
        <strong>TOSIN LASISI</strong>
        <span>PRODUCT DESIGN · LAGOS</span>
      </div>
      <div class="r-rule"></div>
      <div class="r-meta"><span id="r-ch">CH 01</span><span id="r-name">ROQQU</span></div>
      <div class="r-lines" id="r-lines"></div>
      <div class="r-rule"></div>
      <div class="r-ok">APPROVED ✓</div>
      <div class="r-barcode"></div>
    </div>
  </div>

  <div class="pos" role="group" aria-label="Project terminal. Press keys 1 to 5 to switch projects.">
    <div class="printer" aria-hidden="true"><div class="slot"></div></div>

    <div class="screen" id="screen">
      <div class="scr-bar mono">
        <span id="scr-ch">CH 01</span>
        <span class="scr-right"><span id="scr-clock">12:00</span><i class="batt"></i></span>
      </div>

      <!-- CH1 Roqqu: balance counts up, chart draws, trade confirms -->
      <section class="ch" data-for="1">
        <p class="s-label">Portfolio balance</p>
        <p class="s-big" data-count="1284500" data-prefix="₦">₦0</p>
        <svg class="spark" viewBox="0 0 200 50" preserveAspectRatio="none"><path d="M0 42 L20 38 L38 40 L55 30 L72 33 L90 22 L108 26 L126 15 L144 19 L162 9 L180 12 L200 4" /></svg>
        <div class="s-row"><span class="pill pill-coin">BTC</span><span class="s-small">+4.21% today</span></div>
        <div class="toast">Trade complete <b>✓</b></div>
      </section>

      <!-- CH2 EN1: configurator cycles paint colours -->
      <section class="ch" data-for="3">
        <p class="s-label">Configure your EN1</p>
        <svg class="car" viewBox="0 0 220 70"><path class="body" d="M12 50 C14 38 30 34 52 32 L78 18 C88 12 100 10 124 10 L150 11 C166 12 176 20 188 30 C200 32 210 38 210 50 Z" /><circle cx="56" cy="52" r="11" class="wheel"/><circle cx="168" cy="52" r="11" class="wheel"/><path class="glass" d="M84 20 L100 14 L146 14 L170 30 L76 30 Z"/></svg>
        <div class="swatches"><i></i><i></i><i></i><i></i></div>
        <div class="s-row"><span class="s-small">Long range · 21″ wheels</span><span class="s-strong">₦48.5M</span></div>
      </section>

      <!-- CH3 Clink: payment link goes from pending to paid -->
      <section class="ch" data-for="4">
        <p class="s-label">Payment link</p>
        <div class="link-card">
          <span class="mono link-url">clink.ng/ade-kicks</span>
          <span class="s-strong">₦25,000</span>
          <span class="status"><span class="pending">Pending…</span><span class="paid">Paid ✓</span></span>
        </div>
        <div class="s-row"><span class="s-small">12 views · 3 clicks</span><span class="s-small paid-count">1 paid</span></div>
      </section>

      <!-- CH4 Glover Lite: pay for anything, no KYC -->
      <section class="ch" data-for="5">
        <p class="s-label">Hello 👋 · no KYC needed</p>
        <div class="svc"><i>🎁</i><i>📞</i><i>💡</i><i>📶</i><i>📺</i><i>💱</i></div>
        <div class="toast toast-soft">Airtime ₦2,000 · Success <b>✓</b></div>
        <div class="s-row"><span class="s-small">Gift cards · bills · airtime</span><span class="s-strong">2 taps</span></div>
      </section>

      <!-- CH5 Qash: dollar card slides in, naira converts to dollars -->
      <section class="ch" data-for="2">
        <p class="s-label">Dollar balance</p>
        <p class="s-big" data-count="1250" data-prefix="$">$0</p>
        <div class="vcard"><span class="mono">QASH · VIRTUAL</span><span class="mono">•••• 4021</span><b>VISA</b></div>
        <div class="s-row"><span class="s-small">₦1,850,000 → $1,250</span><span class="s-small conv">Converted ✓</span></div>
      </section>

      <!-- CH6 Weave: test pattern -->
      <section class="ch" data-for="6">
        <div class="bars"><i></i><i></i><i></i><i></i><i></i><i></i><i></i></div>
        <p class="s-label center">Weave · case study coming soon</p>
      </section>

      <!-- CH00 hidden game: collect coins -->
      <section class="ch ch-game" data-for="0">
        <canvas id="game" width="240" height="150" aria-label="Coin snake game"></canvas>
        <div class="g-hud mono"><span>₦<b id="g-score">0</b></span><span id="g-msg">Arrows / 2·4·5·6</span></div>
      </section>

      <div class="static" aria-hidden="true"></div>
      <div class="scanlines" aria-hidden="true"></div>
    </div>

    <div class="brand mono"><span>TL·PAY</span><span class="brand-actions"><button class="play-btn mono" data-action="game" aria-label="Play a hidden game">G · play</button><button class="mini-theme" data-action="theme" aria-label="Switch light or dark theme"><svg viewBox="0 0 24 24" width="13" height="13" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2.4"><circle cx="12" cy="12" r="8"/><path d="M12 4a8 8 0 0 1 0 16z" fill="currentColor"/></svg></button></span><span class="leds"><i></i><i></i></span></div>

    <div class="keys">
      {projects.map(p => (
        <button class="key" data-key={p.ch} aria-label={`Channel ${p.ch}: ${p.name}`}>
          <b>{p.ch}</b><small>{p.name.split(' ')[0].slice(0, 6)}</small>
        </button>
      ))}
      <button class="key fn fn-red" data-action="pause" aria-label="Pause autoplay"><b><svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M6 6l12 12M18 6L6 18"/></svg></b></button>
      <button class="key fn fn-yellow" data-action="prev" aria-label="Previous project"><b><svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M15 5l-7 7 7 7"/></svg></b></button>
      <a class="key fn fn-green" id="pos-ok" href="#work" aria-label="Open this case study"><b>OK</b></a>
    </div>
    <div class="card-slot"></div>
  </div>

  <p class="hint serif" aria-hidden="true">press a key ↗</p>

  <div class="caption" aria-live="polite">
    <span class="mono muted" id="cap-ch">CH 01</span>
    <h2 id="cap-name">Roqqu</h2>
    <p id="cap-line" class="muted">Making crypto feel safe enough to trade</p>
  </div>
</div>

<script is:inline define:vars={{ receiptData }}>
  const data = JSON.parse(receiptData);
  const pos = document.getElementById('pos');
  const screen = document.getElementById('screen');
  const receipt = document.getElementById('receipt');
  const $ = id => document.getElementById(id);
  const pad = n => String(n).padStart(2, '0');
  const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
  let cur = 1, timer = null, auto = !reduce;

  function countUp(el) {
    const end = +el.dataset.count, pre = el.dataset.prefix || '', suf = el.dataset.suffix || '';
    const t0 = performance.now(), dur = 1100;
    const fmt = v => pre + Math.round(v).toLocaleString('en-NG') + (pre === '₦' ? '.00' : '') + suf;
    if (reduce) { el.textContent = fmt(end); return; }
    (function tick(t) {
      const k = Math.min(1, (t - t0) / dur), e = 1 - Math.pow(1 - k, 3);
      el.textContent = fmt(end * e);
      if (k < 1) requestAnimationFrame(tick);
    })(t0);
  }

  function printReceipt(p) {
    $('r-ch').textContent = 'CH ' + pad(p.ch);
    $('r-name').textContent = p.name.toUpperCase();
    $('r-lines').innerHTML = p.receipt.map(([k, v]) => `<div><span>${k}</span><i></i><b>${v}</b></div>`).join('');
    receipt.classList.remove('print'); void receipt.offsetWidth; receipt.classList.add('print');
  }

  function setChannel(n) {
    cur = ((n - 1 + data.length) % data.length) + 1;
    const p = data[cur - 1];
    screen.classList.remove('switching'); void screen.offsetWidth; screen.classList.add('switching');
    setTimeout(() => {
      pos.dataset.ch = cur;
      screen.querySelectorAll('.ch').forEach(s => {
        const on = s.dataset.for == cur;
        s.classList.toggle('on', on);
        if (on) { s.classList.remove('play'); void s.offsetWidth; s.classList.add('play'); s.querySelectorAll('[data-count]').forEach(countUp); }
      });
      $('scr-ch').textContent = 'CH ' + pad(cur);
      $('cap-ch').textContent = 'CH ' + pad(cur);
      $('cap-name').textContent = p.name;
      $('cap-line').textContent = p.headline;
      $('pos-ok').href = p.page ? '/work/' + p.slug : '#work';
      printReceipt(p);
    }, 180);
    document.querySelectorAll('.pos .key[data-key]').forEach(k => k.classList.toggle('active', k.dataset.key == cur));
  }

  // ───── Hidden game: CH 00 ─────
  const cv = $('game'), g = cv.getContext('2d');
  const COLS = 24, ROWS = 15, CELL = 10;
  let game = null, gameTimer = null, lastCh = 1;
  function startGame() {
    userInput(); lastCh = cur || lastCh;
    screen.classList.remove('switching'); void screen.offsetWidth; screen.classList.add('switching');
    pos.dataset.ch = 0; pos.classList.add('gaming');
    screen.querySelectorAll('.ch').forEach(s => s.classList.toggle('on', s.dataset.for == 0));
    $('scr-ch').textContent = 'CH 00'; $('cap-ch').textContent = 'CH 00 · SECRET';
    $('cap-name').textContent = 'Coin run'; $('cap-line').textContent = 'Collect the coins. Don’t hit yourself. Press ✕ to exit.';
    document.querySelectorAll('.pos .key[data-key]').forEach(k => k.classList.remove('active'));
    game = { snake: [[6, 7], [5, 7], [4, 7]], dir: [1, 0], next: [1, 0], coin: null, score: 0, over: false };
    placeCoin(); $('g-score').textContent = '0'; $('g-msg').textContent = 'Arrows / 2·4·5·6';
    clearInterval(gameTimer); gameTimer = setInterval(step, 110); draw();
  }
  function stopGame(toCh) {
    clearInterval(gameTimer); game = null; pos.classList.remove('gaming');
    setChannel(toCh || lastCh);
  }
  function placeCoin() {
    do { game.coin = [Math.floor(Math.random() * COLS), Math.floor(Math.random() * ROWS)]; }
    while (game.snake.some(([x, y]) => x === game.coin[0] && y === game.coin[1]));
  }
  function turn(dx, dy) { if (!game || game.over) return; if (dx === -game.dir[0] && dy === -game.dir[1]) return; game.next = [dx, dy]; }
  function step() {
    if (!game || game.over) return;
    game.dir = game.next;
    const [hx, hy] = game.snake[0];
    const nx = (hx + game.dir[0] + COLS) % COLS, ny = (hy + game.dir[1] + ROWS) % ROWS;
    if (game.snake.some(([x, y]) => x === nx && y === ny)) return gameOver();
    game.snake.unshift([nx, ny]);
    if (nx === game.coin[0] && ny === game.coin[1]) { game.score += 1000; $('g-score').textContent = game.score.toLocaleString('en-NG'); placeCoin(); }
    else game.snake.pop();
    draw();
  }
  function gameOver() {
    game.over = true; clearInterval(gameTimer);
    let best = 0; try { best = Math.max(+localStorage.getItem('coinrun') || 0, game.score); localStorage.setItem('coinrun', best); } catch {}
    $('g-msg').textContent = 'Game over · OK to retry';
    $('r-ch').textContent = 'CH 00'; $('r-name').textContent = 'COIN RUN';
    $('r-lines').innerHTML = [['COINS', String(game.score / 1000)], ['TOTAL', '₦' + game.score.toLocaleString('en-NG')], ['BEST', '₦' + best.toLocaleString('en-NG')]].map(([k, v]) => `<div><span>${k}</span><i></i><b>${v}</b></div>`).join('');
    receipt.classList.remove('print'); void receipt.offsetWidth; receipt.classList.add('print');
    draw();
  }
  function draw() {
    g.fillStyle = '#0b0d0c'; g.fillRect(0, 0, cv.width, cv.height);
    g.fillStyle = 'rgba(255,255,255,.04)';
    for (let x = 0; x < COLS; x++) for (let y = 0; y < ROWS; y++) g.fillRect(x * CELL + 4, y * CELL + 4, 2, 2);
    const [cx, cy] = game.coin;
    g.fillStyle = '#f2a900'; g.beginPath(); g.arc(cx * CELL + 5, cy * CELL + 5, 4, 0, Math.PI * 2); g.fill();
    game.snake.forEach(([x, y], i) => { g.fillStyle = i ? '#3fbf78' : '#7dffb2'; g.fillRect(x * CELL + 1, y * CELL + 1, CELL - 2, CELL - 2); });
    if (game.over) { g.fillStyle = 'rgba(0,0,0,.55)'; g.fillRect(0, 0, cv.width, cv.height); g.fillStyle = '#fff'; g.font = '700 14px ui-monospace, monospace'; g.textAlign = 'center'; g.fillText('GAME OVER', cv.width / 2, cv.height / 2); }
  }
  // swipe on the screen (mobile)
  let t0 = null;
  screen.addEventListener('touchstart', e => { if (game) { t0 = e.touches[0]; } }, { passive: true });
  screen.addEventListener('touchend', e => {
    if (!game || !t0) return; const t = e.changedTouches[0], dx = t.clientX - t0.clientX, dy = t.clientY - t0.clientY;
    if (Math.max(Math.abs(dx), Math.abs(dy)) < 20) return;
    Math.abs(dx) > Math.abs(dy) ? turn(Math.sign(dx), 0) : turn(0, Math.sign(dy)); t0 = null;
  });

  function schedule() { clearInterval(timer); if (auto) timer = setInterval(() => setChannel(cur + 1), 6500); }
  function userInput() { pos.classList.add('touched'); auto = false; clearInterval(timer); }

  const toggleTheme = () => window.__toggleTheme();

  pos.addEventListener('click', e => {
    if (e.target.closest('[data-action="game"]')) { e.preventDefault(); return startGame(); }
    if (e.target.closest('[data-action="theme"]')) return toggleTheme();
    const k = e.target.closest('.key'); if (!k) return;
    if (game) {
      e.preventDefault();
      const map = { 2: [0, -1], 4: [-1, 0], 5: [0, 1], 6: [1, 0] };
      if (k.dataset.key && map[k.dataset.key]) return turn(...map[k.dataset.key]);
      if (k.dataset.action === 'pause') return stopGame();
      if (k.id === 'pos-ok' && game.over) return startGame();
      if (k.dataset.key) return stopGame(+k.dataset.key);
      return;
    }
    if (k.dataset.key) { userInput(); setChannel(+k.dataset.key); }
    else if (k.dataset.action === 'prev') { userInput(); setChannel(cur - 1); }
    else if (k.dataset.action === 'pause') { userInput(); }
  });
  addEventListener('keydown', e => {
    if (e.target.closest('input,textarea') || e.metaKey || e.ctrlKey) return;
    const r = pos.getBoundingClientRect(); if (r.bottom < 0 || r.top > innerHeight) return;
    if (game) {
      const m = { ArrowUp: [0, -1], ArrowDown: [0, 1], ArrowLeft: [-1, 0], ArrowRight: [1, 0], w: [0, -1], s: [0, 1], a: [-1, 0], d: [1, 0] };
      if (m[e.key]) { e.preventDefault(); return turn(...m[e.key]); }
      if (e.key === 'Escape') return stopGame();
      if (e.key === 'Enter' && game.over) return startGame();
      return;
    }
    if (e.key === 'g' || e.key === 'G') return startGame();
    if (e.key >= '1' && e.key <= String(data.length)) { userInput(); setChannel(+e.key); }
    if (e.key === 'ArrowRight') { userInput(); setChannel(cur + 1); }
    if (e.key === 'ArrowLeft') { userInput(); setChannel(cur - 1); }
  });

  const clock = () => { const d = new Date(); $('scr-clock').textContent = d.toLocaleTimeString('en-GB', { hour: '2-digit', minute: '2-digit', timeZone: 'Africa/Lagos' }); };
  clock(); setInterval(clock, 30000);

  // Start after the loader lifts
  const start = () => { setChannel(1); schedule(); };
  document.documentElement.classList.contains('is-loading') ? setTimeout(start, 1300) : start();
</script>

<style>
  .pos-wrap {
    --w: clamp(260px, 26vw, 330px);
    position: relative; width: var(--w); margin-inline: auto;
    padding-top: 196px; /* room for the receipt */
  }

  /* ───── Receipt ───── */
  .receipt-clip {
    position: absolute; left: 12%; right: 12%; top: 0; height: 214px;
    overflow: hidden; z-index: 0;
  }
  .receipt {
    position: absolute; left: 0; right: 0; bottom: 0;
    background: var(--paper); color: #1b1a17;
    font-family: var(--f-mono); font-size: 9.5px; line-height: 1.55; letter-spacing: .03em;
    padding: 14px 12px 10px;
    box-shadow: 0 1px 0 rgba(0,0,0,.06), 0 10px 30px -12px rgba(0,0,0,.25);
    transform: translateY(100%);
    --zz: 6px;
    -webkit-mask: linear-gradient(#000 0 0) 0 var(--zz) / 100% 100% no-repeat, conic-gradient(from 135deg at 50% 0, #000 90deg, #0000 0) 0 0 / calc(var(--zz) * 2) var(--zz) repeat-x;
    mask: linear-gradient(#000 0 0) 0 var(--zz) / 100% 100% no-repeat, conic-gradient(from 135deg at 50% 0, #000 90deg, #0000 0) 0 0 / calc(var(--zz) * 2) var(--zz) repeat-x;
  }
  .receipt.print { animation: print 1.1s steps(14, end) .15s forwards; }
  @keyframes print { from { transform: translateY(100%) } to { transform: translateY(0) } }
  .r-head { text-align: center; display: grid; gap: 1px; }
  .r-head strong { font-size: 11px; letter-spacing: .12em; }
  .r-head span { opacity: .6; font-size: 8.5px; }
  .r-rule { border-top: 1px dashed rgba(0,0,0,.35); margin: 7px 0; }
  .r-meta { display: flex; justify-content: space-between; font-weight: 700; margin-bottom: 4px; }
  .r-lines :global(div) { display: flex; gap: 4px; align-items: baseline; }
  .r-lines :global(i) { flex: 1; border-bottom: 1px dotted rgba(0,0,0,.4); transform: translateY(-3px); }
  .r-lines :global(b) { font-weight: 700; }
  .r-ok { text-align: center; font-weight: 700; letter-spacing: .2em; }
  .r-barcode { height: 18px; margin: 6px 8px 0; background: repeating-linear-gradient(90deg, #1b1a17 0 1px, transparent 1px 3px, #1b1a17 3px 5px, transparent 5px 6px, #1b1a17 6px 7px, transparent 7px 10px); }

  /* ───── Terminal body ───── */
  .pos {
    position: relative; z-index: 1; margin-top: 16px;
    background:
      radial-gradient(120% 60% at 30% 0%, var(--hl), transparent 60%),
      linear-gradient(180deg, var(--surface), color-mix(in oklab, var(--surface) 88%, var(--text)));
    border: 1.5px solid var(--line-strong);
    border-radius: 28px 28px 40px 40px;
    padding: 22px 18px 26px;
    box-shadow: 0 1px 0 var(--line), 0 40px 70px -34px rgba(0,0,0,.45), 0 14px 24px -18px rgba(0,0,0,.25), inset 0 -6px 0 var(--line), inset 0 1.5px 0 var(--hl);
  }
  .screen::after { content: ''; position: absolute; inset: 0; pointer-events: none; border-radius: 6px; background: linear-gradient(115deg, rgba(255,255,255,.09) 0%, rgba(255,255,255,.02) 28%, transparent 30%); }
  .ch-game { inset: 26px 8px 8px; gap: 4px; }
  .ch-game canvas { width: 100%; height: auto; image-rendering: pixelated; border-radius: 4px; }
  .g-hud { display: flex; justify-content: space-between; font-size: 9px; opacity: .8; }
  .g-hud b { color: var(--coin); }
  .play-btn { appearance: none; border: 1px dashed var(--line-strong); background: none; color: var(--muted); border-radius: 6px; padding: 2px 6px; font-size: 9px; cursor: pointer; opacity: .7; transition: opacity .2s, background .2s; }
  .play-btn:hover { opacity: 1; background: color-mix(in oklab, var(--coin) 20%, transparent); color: var(--text); }
  .gaming .key[data-key='2'] small, .gaming .key[data-key='4'] small, .gaming .key[data-key='5'] small, .gaming .key[data-key='6'] small { visibility: hidden; }
  .gaming .key[data-key='2']::after { content: '↑'; } .gaming .key[data-key='4']::after { content: '←'; } .gaming .key[data-key='5']::after { content: '↓'; } .gaming .key[data-key='6']::after { content: '→'; }
  .brand-actions { display: inline-flex; gap: 6px; align-items: center; }
  .mini-theme { appearance: none; display: grid; place-items: center; width: 22px; height: 18px; border: 1px dashed var(--line-strong); border-radius: 6px; background: none; color: var(--muted); cursor: pointer; opacity: .8; }
  .mini-theme:hover { opacity: 1; color: var(--text); background: color-mix(in oklab, var(--coin) 20%, transparent); }
  /* CH4 Glover Lite */
  .svc { display: grid; grid-template-columns: repeat(6, 1fr); gap: 5px; margin-top: 4px; }
  .svc i { font-style: normal; aspect-ratio: 1; border-radius: 50%; display: grid; place-items: center; font-size: 13px; background: rgba(255,255,255,.08); opacity: 0; transform: scale(.6); }
  .play .svc i { animation: pop .4s var(--ease) forwards; }
  .play .svc i:nth-child(2) { animation-delay: .08s } .play .svc i:nth-child(3) { animation-delay: .16s } .play .svc i:nth-child(4) { animation-delay: .24s } .play .svc i:nth-child(5) { animation-delay: .32s } .play .svc i:nth-child(6) { animation-delay: .4s }
  .toast-soft { background: #b9a6ff; color: #1b1240; }
  /* CH5 Qash */
  .vcard { position: relative; height: 54px; border-radius: 9px; padding: 7px 9px; background: linear-gradient(135deg, #6c4ee0, #2b1a73); display: grid; grid-template-columns: 1fr auto; align-content: space-between; color: #fff; transform: translateX(110%) rotate(6deg); }
  .vcard .mono { font-size: 7.5px; opacity: .85; } .vcard b { font: italic 800 11px var(--f-display); text-align: right; grid-column: 2; grid-row: 2; }
  .play .vcard { animation: slidecard .7s .3s var(--ease) forwards; }
  @keyframes slidecard { to { transform: none; } }
  .conv { opacity: 0; color: #5fe39a; } .play .conv { animation: in .3s 1.3s forwards; }
  .gaming .key::after { position: absolute; bottom: 4px; font: 600 10px var(--f-mono); color: var(--coin); }
  .key { position: relative; }
  .printer { position: absolute; top: -16px; left: 9%; right: 9%; height: 34px; border: 1.5px solid var(--line-strong); border-bottom: 0; border-radius: 18px 18px 0 0; background: var(--surface); }
  .slot { position: absolute; top: 9px; left: 6%; right: 6%; height: 5px; border-radius: 4px; background: var(--text); opacity: .85; }
  .key b svg { display: block; }

  .screen {
    position: relative; overflow: hidden;
    aspect-ratio: 4 / 3.15;
    background: var(--screen); color: var(--screen-text);
