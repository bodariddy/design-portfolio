---
// "Interaction wall" (ref: a wall of isolated micro-interactions; click to expand, Esc to close).
// Each tile loops one real moment from the case study, rebuilt in code.
interface Props { title?: string }
const { title = 'Interaction details' } = Astro.props;
---
<section class="iwall wrap" aria-labelledby="iw-title">
  <div class="iw-head">
    <p class="mono muted">Details</p>
    <h2 id="iw-title">{title}</h2>
    <p class="muted iw-sub">The small moments that carry the trust. Rebuilt in code. Click any tile to expand it.</p>
  </div>

  <div class="iw-grid">
    <button class="tile dark" data-label="Slide to confirm · Contracts">
      <div class="demo d-slide"><div class="track"><span class="knob">→</span><span class="txt t1">Slide to buy Long</span><span class="txt t2">Position opened ✓</span></div></div>
    </button>

    <button class="tile light" data-label="Liveness check · KYC">
      <div class="demo d-live"><div class="ring">{Array.from({ length: 36 }, (_, i) => <i style={`--i:${i}`}></i>)}</div><span class="face">☺</span><p class="cap">Tilt your face to the left</p></div>
    </button>

    <button class="tile dark" data-label="Transaction timeline · Send">
      <div class="demo d-time">
        <p class="amt">0.0125 ETH</p>
        <ol><li><b></b>Transaction initiated</li><li><b></b>In progress</li><li><b></b>Confirmed</li></ol>
        <span class="done">Successful</span>
      </div>
    </button>

    <button class="tile light" data-label="Leverage & liquidation · Contracts">
      <div class="demo d-lev">
        <div class="lv-top"><span>Leverage</span><b class="lv-x"></b></div>
        <div class="bar"><span class="fill"></span><span class="thumb"></span></div>
        <div class="lv-row"><span>Liquidation price</span><b class="lv-liq"></b></div>
      </div>
    </button>

    <button class="tile dark" data-label="Return calculator · Staking">
      <div class="demo d-calc"><span class="mono lbl">You can earn</span><p class="earn"></p><span class="mono sol">If you stake <b class="stake"></b> SOL · 7.2% APY</span></div>
    </button>

    <button class="tile light" data-label="Network checker · Safety">
      <div class="demo d-net">
        <div class="addr"><span class="typed">TF2GJrpEviqp7…KocqHfvd</span></div>
        <div class="chips"><span class="ok">USDT-TRC20 ✓</span><span class="no">ERC20 ✕</span><span class="no">SOL ✕</span></div>
        <p class="hint">Only send on a supported network</p>
      </div>
    </button>
  </div>

  <dialog class="iw-dialog" id="iw-dialog">
    <div class="dlg-stage"></div>
    <p class="mono dlg-label"></p>
    <button class="esc mono" aria-label="Close">esc</button>
  </dialog>
</section>

<script is:inline>
  (function () {
    const dlg = document.getElementById('iw-dialog'); if (!dlg) return;
    const stage = dlg.querySelector('.dlg-stage'), label = dlg.querySelector('.dlg-label');
    document.querySelectorAll('.iwall .tile').forEach(t => t.addEventListener('click', () => {
      stage.className = 'dlg-stage ' + (t.classList.contains('dark') ? 'dark' : 'light');
      stage.innerHTML = t.innerHTML; label.textContent = t.dataset.label;
      dlg.showModal();
    }));
    dlg.querySelector('.esc').addEventListener('click', () => dlg.close());
    dlg.addEventListener('click', e => { if (e.target === dlg) dlg.close(); });
  })();
</script>

<style>
  .iwall { padding-block: clamp(56px, 8vw, 110px); border-top: 1.5px solid var(--line); }
  .iw-head h2 { font-size: clamp(34px, 4.6vw, 72px); letter-spacing: -.05em; line-height: .95; margin: 14px 0 10px; font-weight: 800; }
  .iw-sub { margin: 0 0 32px; max-width: 52ch; }
  .iw-grid { display: grid; grid-template-columns: repeat(3, 1fr); grid-auto-rows: 290px; gap: 10px; }
  .tile { appearance: none; border: 0; padding: 0; cursor: zoom-in; position: relative; overflow: hidden; border-radius: 18px; display: grid; place-items: center; font: inherit; color: inherit; transition: transform .4s var(--ease); }
  .tile:hover { transform: scale(.985); }
  .tile::after { content: attr(data-label); position: absolute; left: 14px; bottom: 12px; font: 500 10.5px var(--f-mono); letter-spacing: .04em; text-transform: uppercase; opacity: .55; }
  .tall { grid-row: span 2; }
  .dark { background: #121212; color: #f3f1ec; }
  .light { background: #e9e7e3; color: #171614; }
  :global(:root[data-theme='dark']) .light { background: #232120; color: #f1ebe0; }
  @media (prefers-color-scheme: dark) { :global(:root:not([data-theme='light'])) .light { background: #232120; color: #f1ebe0; } }

  .demo { position: relative; width: 76%; max-width: 300px; text-align: left; }

  /* 1 · Slide to confirm */
  .d-slide .track { position: relative; height: 52px; border-radius: 99px; background: rgba(255,255,255,.1); overflow: hidden; }
  .d-slide .knob { position: absolute; left: 5px; top: 5px; width: 42px; height: 42px; border-radius: 50%; display: grid; place-items: center; background: #fff; color: #111; font-weight: 700; z-index: 2; animation: knob 3.2s var(--ease) infinite; }
  .d-slide .txt { position: absolute; inset: 0; display: grid; place-items: center; font-size: 14px; font-weight: 600; }
  .d-slide .t1 { opacity: .55; animation: t1 3.2s infinite; } .d-slide .t2 { opacity: 0; color: #5fe39a; animation: t2 3.2s infinite; }
  .d-slide .track::before { content: ''; position: absolute; inset: 0; background: #1f7a4a; transform: scaleX(0); transform-origin: left; animation: fillx 3.2s var(--ease) infinite; }
  @keyframes knob { 0%, 15% { left: 5px; } 55%, 100% { left: calc(100% - 47px); } }
  @keyframes fillx { 0%, 15% { transform: scaleX(0); } 55%, 100% { transform: scaleX(1); } }
  @keyframes t1 { 0%, 40% { opacity: .55; } 50%, 100% { opacity: 0; } }
  @keyframes t2 { 0%, 55% { opacity: 0; } 62%, 92% { opacity: 1; } 100% { opacity: 0; } }

  /* 2 · Liveness ring */
  .d-live { display: grid; place-items: center; }
  .ring { position: relative; width: 150px; height: 150px; }
  .ring i { position: absolute; left: 50%; top: 0; width: 3px; height: 14px; margin-left: -1.5px; border-radius: 2px; background: currentColor; opacity: .18; transform-origin: 1.5px 75px; transform: rotate(calc(var(--i) * 10deg)); animation: tickon 3.6s infinite; animation-delay: calc(var(--i) * 60ms); }
  @keyframes tickon { 0%, 5% { opacity: .18; background: currentColor; } 12%, 85% { opacity: 1; background: #3d6bff; } 100% { opacity: .18; } }
  .face { position: absolute; top: 44px; font-size: 52px; opacity: .8; animation: tilt 3.6s infinite; }
  @keyframes tilt { 0%, 20% { transform: none; } 45%, 80% { transform: rotate(-14deg) translateX(-6px); } 100% { transform: none; } }
  .cap { margin: 12px 0 0; font-size: 13px; opacity: .7; }

  /* 3 · Transaction timeline */
  .d-time .amt { font-size: 26px; font-weight: 800; letter-spacing: -.03em; margin: 0 0 14px; }
  .d-time ol { list-style: none; margin: 0; padding: 0; display: grid; gap: 12px; }
  .d-time li { display: flex; align-items: center; gap: 12px; font-size: 14px; opacity: .4; animation: step 4.5s infinite; }
  .d-time li:nth-child(2) { animation-delay: .9s; } .d-time li:nth-child(3) { animation-delay: 1.8s; }
  .d-time b { width: 14px; height: 14px; border-radius: 50%; border: 2px solid currentColor; }
  @keyframes step { 0% { opacity: .4; } 10%, 70% { opacity: 1; } 10% { color: inherit; } 100% { opacity: .4; } }
  .d-time li { --c: #5fe39a; }
  .d-time li b { animation: dot 4.5s infinite; animation-delay: inherit; }
  @keyframes dot { 0% { background: transparent; border-color: currentColor; } 10%, 70% { background: var(--c); border-color: var(--c); } 100% { background: transparent; } }
  .done { display: inline-block; margin-top: 16px; padding: 6px 12px; border-radius: 99px; background: #1f7a4a; color: #d9ffe9; font-size: 13px; font-weight: 600; opacity: 0; animation: done 4.5s infinite; }
  @keyframes done { 0%, 45% { opacity: 0; transform: translateY(6px); } 55%, 80% { opacity: 1; transform: none; } 100% { opacity: 0; } }

  /* 4 · Leverage + liquidation (CSS counters via @property) */
  @property --lev { syntax: '<integer>'; inherits: true; initial-value: 5; }
  @property --liq { syntax: '<integer>'; inherits: true; initial-value: 92; }
  .d-lev { animation: lev 4s ease-in-out infinite alternate; counter-reset: lev var(--lev) liq var(--liq); }
  @keyframes lev { from { --lev: 5; --liq: 92; } to { --lev: 20; --liq: 98; } }
  .lv-top, .lv-row { display: flex; justify-content: space-between; font-size: 13px; }
  .lv-x::after { content: counter(lev) '×'; font-size: 22px; letter-spacing: -.02em; }
  .lv-liq::after { content: '$' counter(liq) ',450'; color: #e5484d; }
  .bar { position: relative; height: 6px; margin: 16px 0 18px; border-radius: 99px; background: rgba(127,127,127,.25); }
  .bar .fill { position: absolute; inset: 0; right: auto; width: calc((var(--lev) - 5) / 15 * 100%); border-radius: inherit; background: var(--coin); }
  .bar .thumb { position: absolute; top: 50%; left: calc((var(--lev) - 5) / 15 * 100%); width: 20px; height: 20px; margin: -10px 0 0 -10px; border-radius: 50%; background: #fff; box-shadow: 0 2px 8px rgba(0,0,0,.3); }

  /* 5 · Return calculator */
  @property --st { syntax: '<integer>'; inherits: true; initial-value: 5; }
  .d-calc { text-align: center; animation: st 3.5s ease-in-out infinite alternate; counter-reset: st var(--st) earn calc(var(--st) * 72); }
  @keyframes st { from { --st: 5; } to { --st: 50; } }
  .lbl { opacity: .6; }
  .earn { margin: 8px 0; font-size: 34px; font-weight: 800; letter-spacing: -.03em; color: #5fe39a; }
  .earn::before { content: '+0.' counter(earn) ' SOL'; }
  .stake::before { content: counter(st) '.0'; }
  .sol { opacity: .7; text-transform: none; letter-spacing: 0; }

  /* 6 · Network checker */
  .d-net .addr { border-radius: 10px; padding: 12px; background: rgba(127,127,127,.15); font: 500 12px var(--f-mono); overflow: hidden; white-space: nowrap; }
  .typed { display: inline-block; overflow: hidden; vertical-align: bottom; animation: type 4s steps(22) infinite; }
  @keyframes type { 0% { width: 0; } 35%, 100% { width: 100%; } }
  .chips { display: flex; gap: 6px; flex-wrap: wrap; margin-top: 12px; }
  .chips span { font: 600 11px var(--f-mono); padding: 5px 9px; border-radius: 99px; opacity: 0; animation: chip 4s infinite; }
  .chips .ok { background: #1f7a4a; color: #d9ffe9; animation-delay: .2s; } .chips .no { background: rgba(229,72,77,.18); color: #e5484d; }
  .chips span:nth-child(2) { animation-delay: .35s; } .chips span:nth-child(3) { animation-delay: .5s; }
  @keyframes chip { 0%, 38% { opacity: 0; transform: translateY(6px); } 45%, 90% { opacity: 1; transform: none; } 100% { opacity: 0; } }
  .hint { margin: 12px 0 0; font-size: 12.5px; opacity: .6; }

  /* Dialog */
  .iw-dialog { width: min(1100px, 92vw); height: min(720px, 84vh); padding: 0; border: 0; border-radius: 24px; overflow: hidden; background: transparent; }
  .iw-dialog::backdrop { background: rgba(0,0,0,.6); backdrop-filter: blur(6px); }
  .dlg-stage { position: absolute; inset: 0; display: grid; place-items: center; }
  .dlg-stage.dark { background: #0f0f0f; color: #f3f1ec; } .dlg-stage.light { background: #ecebe8; color: #171614; }
  .dlg-stage .demo { transform: scale(1.6); }
  .dlg-label { position: absolute; left: 22px; top: 18px; margin: 0; opacity: .6; color: #888; }
  .esc { position: absolute; left: 50%; bottom: 20px; transform: translateX(-50%); border: 0; border-radius: 8px; padding: 7px 12px; background: #2a2a2a; color: #eee; cursor: pointer; font-size: 12px; }

  @media (max-width: 900px) { .iw-grid { grid-template-columns: 1fr 1fr; } }
  @media (max-width: 600px) { .iw-grid { grid-template-columns: 1fr; grid-auto-rows: 220px; } .tall { grid-row: span 1; } .dlg-stage .demo { transform: scale(1.15); } }
  @media (prefers-reduced-motion: reduce) { .demo *, .demo { animation: none !important; } .d-slide .t1 { opacity: .55; } }
</style>
