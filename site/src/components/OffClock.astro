---
// "Off the clock" as three small toys (inspired by the interactivity of Jaykay's about page,
// but our own mechanics): hold to lift, a reaction-time game, and a bookshelf you can pull from.
const books = [
  { t: 'Product', c: '#2b36c9', h: 88, line: 'How good teams decide what to build, and what to say no to.' },
  { t: 'Psychology', c: '#c92f63', h: 100, line: 'Why people hesitate, trust, or abandon. My favourite design manual.' },
  { t: 'Decisions', c: '#1d5c45', h: 80, line: 'Risk, money and choices under uncertainty. Useful in fintech.' },
  { t: 'Fiction', c: '#b9512b', h: 94, line: 'The occasional novel to switch off. Stories make better designers.' },
  { t: 'Design', c: '#e0a100', h: 84, line: 'Craft, type and systems: the books that sit open on my desk.' },
];
---
<section class="off wrap" aria-labelledby="o-title">
  <div class="off-head">
    <p class="mono muted">Off the clock</p>
    <h2 id="o-title">When I’m not in <span class="serif">Figma</span></h2>
    <p class="muted o-sub">Three things that keep me sharp. Go on, have a go.</p>
  </div>

  <div class="toys" data-reveal>
    <!-- 1 · Training: press & hold to lift -->
    <article class="toy" id="t-lift">
      <div class="stage s-lift">
        <div class="bar-wrap" aria-hidden="true">
          <div class="barbell"><i class="pl"></i><i class="pl s"></i><span class="rod"></span><i class="pl s"></i><i class="pl"></i></div>
        </div>
        <div class="meter" aria-hidden="true"><span class="fill"></span></div>
        <p class="readout mono"><b id="reps">0</b> reps · set <b id="set">1</b>/4</p>
        <button class="act" id="lift-btn" aria-describedby="lift-help">Hold to lift</button>
        <span id="lift-help" class="sr-only">Press and hold the button, or hold the space bar while it is focused, to complete a rep.</span>
      </div>
      <h3>Training</h3>
      <p>Working out keeps me disciplined and clear-headed. It’s also where a lot of my best ideas show up.</p>
      <span class="mono tagline">Body · discipline</span>
    </article>

    <!-- 2 · Gaming: reaction test -->
    <article class="toy" id="t-react">
      <div class="stage s-react">
        <button class="pad" id="react-pad" data-state="idle" aria-live="polite">
          <span class="p-main">Tap to start</span>
          <span class="p-sub mono">Test your reflexes</span>
        </button>
        <p class="readout mono">Best <b id="best">—</b></p>
      </div>
      <h3>Gaming</h3>
      <p>It started in my dad’s study and never stopped. Games are still my favourite lesson in onboarding, feedback and reward.</p>
      <span class="mono tagline">Play · curiosity</span>
    </article>

    <!-- 3 · Reading: pull a book from the shelf -->
    <article class="toy" id="t-read">
      <div class="stage s-read">
        <div class="shelf" role="listbox" aria-label="Bookshelf: pick a book">
          {books.map((b, i) => (
            <button class="book" role="option" aria-selected={i === 1 ? 'true' : 'false'} style={`--c:${b.c};--h:${b.h}%`} data-line={b.line}>
              <span>{b.t}</span>
            </button>
          ))}
        </div>
        <p class="note" id="book-note">Why people hesitate, trust, or abandon. My favourite design manual.</p>
      </div>
      <h3>Reading</h3>
      <p>Books on product, psychology and how people make decisions, plus the occasional novel to switch off.</p>
      <span class="mono tagline">Mind · perspective</span>
    </article>
  </div>
</section>

<script is:inline>
  (function () {
    // ── Lift: hold to fill, release to count a rep
    const lift = document.getElementById('t-lift'); if (!lift) return;
    const btn = document.getElementById('lift-btn'), repsEl = document.getElementById('reps'), setEl = document.getElementById('set');
    let p = 0, raf = null, holding = false, reps = 0, set = 1;
    const draw = () => lift.style.setProperty('--p', p.toFixed(3));
    const loop = () => {
      p = holding ? Math.min(1, p + 0.028) : Math.max(0, p - 0.06); draw();
      if (holding && p >= 1) { holding = false; reps++; if (reps > 8) { reps = 1; set = set % 4 + 1; } repsEl.textContent = reps; setEl.textContent = set; lift.classList.add('done'); setTimeout(() => lift.classList.remove('done'), 450); btn.textContent = reps === 8 ? 'Set complete 💪' : 'Again'; }
      if (p > 0 || holding) raf = requestAnimationFrame(loop); else raf = null;
    };
    const start = e => { e.preventDefault(); holding = true; btn.textContent = 'Lifting…'; if (!raf) raf = requestAnimationFrame(loop); };
    const stop = () => { holding = false; };
    btn.addEventListener('pointerdown', start); addEventListener('pointerup', stop); btn.addEventListener('pointerleave', stop);
    btn.addEventListener('keydown', e => { if ((e.key === ' ' || e.key === 'Enter') && !e.repeat) start(e); });
    btn.addEventListener('keyup', e => { if (e.key === ' ' || e.key === 'Enter') stop(); });

    // ── Reaction: wait for green, then tap
    const pad = document.getElementById('react-pad'), main = pad.querySelector('.p-main'), sub = pad.querySelector('.p-sub'), bestEl = document.getElementById('best');
    let t = null, t0 = 0, best = null;
    try { best = +localStorage.getItem('reactBest') || null; } catch {}
    if (best) bestEl.textContent = best + 'ms';
    const set_ = (s, m, d) => { pad.dataset.state = s; main.textContent = m; sub.textContent = d; };
    pad.addEventListener('click', () => {
      const s = pad.dataset.state;
      if (s === 'idle' || s === 'result' || s === 'early') {
        set_('wait', 'Wait for green…', 'Don’t jump the gun');
        t = setTimeout(() => { set_('go', 'TAP!', 'Now!'); t0 = performance.now(); }, 900 + Math.random() * 1800);
      } else if (s === 'wait') { clearTimeout(t); set_('early', 'Too early', 'Tap to try again'); }
      else if (s === 'go') {
        const ms = Math.round(performance.now() - t0);
        const verdict = ms < 220 ? 'Pro reflexes' : ms < 300 ? 'Solid' : 'Warm-up round';
        if (!best || ms < best) { best = ms; bestEl.textContent = ms + 'ms'; try { localStorage.setItem('reactBest', ms); } catch {} }
        set_('result', ms + 'ms', verdict + ' · tap to retry');
      }
    });

    // ── Reading: pick a spine
    const shelf = document.querySelectorAll('#t-read .book'), note = document.getElementById('book-note');
    shelf.forEach(b => b.addEventListener('click', () => {
      shelf.forEach(x => x.setAttribute('aria-selected', x === b ? 'true' : 'false'));
      note.classList.remove('in'); void note.offsetWidth; note.textContent = b.dataset.line; note.classList.add('in');
    }));
  })();
</script>

<style>
  .off { padding-block: clamp(56px, 8vw, 110px); border-top: 1.5px solid var(--line); }
  .off-head h2 { font-size: clamp(40px, 6vw, 92px); letter-spacing: -.055em; line-height: .95; margin: 12px 0 12px; font-weight: 800; }
  .off-head .serif { font-weight: 400; color: var(--accent-text); }
  .o-sub { margin: 0 0 clamp(28px, 4vw, 44px); font-size: 18px; }
  .toys { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 16px; }
  .toy { display: flex; flex-direction: column; gap: 8px; padding: 10px 10px 22px; border-radius: 24px; background: var(--surface); box-shadow: inset 0 0 0 1px var(--line); }
  .toy > h3, .toy > p, .toy > .tagline { margin-inline: 12px; }
  .toy h3 { margin-top: 10px; margin-bottom: 0; font-size: 24px; letter-spacing: -.03em; }
  .toy > p { margin-top: 0; margin-bottom: 0; color: var(--muted); font-size: 15.5px; }
  .tagline { margin-top: auto; padding-top: 12px; color: var(--muted); }
  .stage { position: relative; height: 230px; border-radius: 16px; overflow: hidden; display: grid; place-items: center; align-content: center; gap: 12px;
    background: radial-gradient(circle, color-mix(in oklab, var(--text) 12%, transparent) 1px, transparent 1.4px) 0 0 / 16px 16px, color-mix(in oklab, var(--bg) 70%, var(--surface)); }
  .readout { margin: 0; color: var(--muted); }
  .readout b { color: var(--text); }
  .act { appearance: none; border: 0; border-radius: 99px; padding: 10px 18px; background: var(--text); color: var(--bg); font: 600 14px var(--f-display); cursor: pointer; touch-action: none; user-select: none; -webkit-user-select: none; transition: transform .15s; }
  .act:active { transform: scale(.96); }

  /* Lift */
  .s-lift { --c: #e2793f; }
  .bar-wrap { height: 70px; display: grid; align-items: end; }
  .barbell { display: flex; align-items: center; transform: translateY(calc(var(--p, 0) * -34px)) rotate(calc((var(--p, 0) - .5) * 2deg)); transition: transform .08s linear; }
  .rod { width: 120px; height: 5px; border-radius: 3px; background: var(--text); }
  .pl { width: 14px; height: 54px; border-radius: 4px; background: var(--c); margin: 0 2px; }
  .pl.s { height: 38px; width: 10px; }
  .meter { width: 70%; height: 6px; border-radius: 99px; background: var(--line); overflow: hidden; }
  .meter .fill { display: block; height: 100%; width: calc(var(--p, 0) * 100%); background: var(--c); }
  .done .readout b { color: var(--c); }
  .done .stage { animation: pulse .45s var(--ease); }
  @keyframes pulse { 50% { box-shadow: inset 0 0 0 3px var(--c); } }

  /* Reaction */
  .pad { appearance: none; border: 0; width: 82%; height: 140px; border-radius: 18px; cursor: pointer; display: grid; place-content: center; gap: 4px; color: #fff; font: inherit; transition: background .15s, transform .1s; background: #3946e0; }
  .pad:active { transform: scale(.98); }
  .p-main { font-size: 26px; font-weight: 800; letter-spacing: -.03em; }
  .p-sub { opacity: .8; }
  .pad[data-state='wait'] { background: #c93a3f; }
  .pad[data-state='go'] { background: #2fb36a; }
  .pad[data-state='early'] { background: #8a5a12; }
  .pad[data-state='result'] { background: #171614; }

  /* Reading */
  .s-read { align-content: end; padding-bottom: 14px; }
  .shelf { display: flex; align-items: flex-end; gap: 5px; height: 130px; padding: 0 10px; border-bottom: 5px solid color-mix(in oklab, var(--text) 70%, var(--bg)); }
  .book { appearance: none; border: 0; width: 34px; height: var(--h); border-radius: 3px 3px 1px 1px; background: var(--c); color: #fff; cursor: pointer; display: grid; place-items: center; transition: transform .35s var(--ease); box-shadow: inset -4px 0 0 rgba(0,0,0,.18); }
  .book span { writing-mode: vertical-rl; transform: rotate(180deg); font: 600 11px var(--f-mono); letter-spacing: .08em; text-transform: uppercase; }
  .book:hover { transform: translateY(-6px); }
  .book[aria-selected='true'] { transform: translateY(-18px) rotate(-4deg); }
  .note { margin: 0; width: 86%; min-height: 40px; text-align: center; font-family: var(--f-serif); font-style: italic; font-size: 17px; line-height: 1.25; }
  .note.in { animation: fadeup .4s var(--ease); }
  @keyframes fadeup { from { opacity: 0; transform: translateY(6px); } }

  @media (max-width: 1000px) { .toys { grid-template-columns: 1fr 1fr; } }
  @media (max-width: 640px) { .toys { grid-template-columns: 1fr; } }
</style>
