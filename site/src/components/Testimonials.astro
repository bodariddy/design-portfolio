---
import { testimonials } from '../data/site';
---
<section class="tm wrap" aria-labelledby="tm-title">
  <div class="tm-head">
    <p class="mono muted">Kind words</p>
    <h2 id="tm-title">From the people I <span class="serif">build with</span></h2>
  </div>
  <ul class="tm-grid" role="list" data-reveal>
    {testimonials.map(t => (
      <li class={t.placeholder ? 'ph' : ''}>
        <span class="q" aria-hidden="true">“</span>
        <blockquote>{t.quote}</blockquote>
        <p class="who"><span class="av" aria-hidden="true">{t.name.charAt(0)}</span><span><strong>{t.name}</strong><span class="muted">{t.role} · {t.company}</span></span></p>
      </li>
    ))}
  </ul>
</section>

<style>
  .tm { padding-block: clamp(56px, 8vw, 110px); border-top: 1.5px solid var(--line); }
  .tm-head h2 { font-size: clamp(34px, 4.6vw, 72px); letter-spacing: -.05em; line-height: .95; margin: 14px 0 clamp(28px, 4vw, 48px); font-weight: 800; }
  .tm-head .serif { font-weight: 400; color: var(--accent-text); }
  .tm-grid { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: clamp(14px, 1.6vw, 22px); }
  .tm-grid li { display: flex; flex-direction: column; gap: 14px; padding: 26px 24px 22px; border-radius: 22px; background: color-mix(in oklab, var(--surface) 70%, var(--bg)); box-shadow: inset 0 0 0 1px var(--line); }
  .tm-grid li.ph { box-shadow: inset 0 0 0 1.5px color-mix(in oklab, var(--coin) 55%, transparent); background-image: repeating-linear-gradient(135deg, transparent 0 12px, color-mix(in oklab, var(--coin) 5%, transparent) 12px 13px); }
  .q { font: 400 64px/0.6 var(--f-serif); color: var(--coin); height: 26px; }
  blockquote { margin: 0; font-size: 17px; line-height: 1.5; flex: 1; }
  .ph blockquote { color: var(--muted); font-style: italic; }
  .who { display: flex; align-items: center; gap: 12px; margin: 0; padding-top: 14px; border-top: 1px solid var(--line); font-size: 14px; }
  .who > span:last-child { display: grid; }
  .av { width: 38px; height: 38px; border-radius: 50%; display: grid; place-items: center; background: var(--text); color: var(--bg); font-weight: 700; }
  @media (max-width: 900px) { .tm-grid { grid-template-columns: 1fr; } }
</style>
