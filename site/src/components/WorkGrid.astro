---
import { projects } from '../data/projects';
---
<section id="work" class="work" aria-labelledby="work-title">
  <div class="wrap work-head">
    <h2 id="work-title">Selected <span class="serif">work</span></h2>
    <p class="mono muted">05 case studies · 2019 — now</p>
  </div>

  <ul class="grid" role="list" id="grid">
    {projects.map((p, i) => {
      const soon = p.slug === 'weave';
      return (
      <li class={`tile ${i < 2 ? 'tile-lg' : ''} ${soon ? 'soon' : ''}`} style={`--world: var(${p.colour})`}>
        <a href={soon ? '#work' : `/work/${p.slug}`} aria-label={`${p.name}: ${p.headline}`} data-cursor={soon ? 'Coming soon' : 'View case study'}>
          <div class="t-top mono">
            <span>CH {String(p.ch).padStart(2, '0')}</span>
            <span>{p.years}</span>
          </div>

          <div class="t-media" aria-hidden="true">
            <div class={`device device-${p.device}`}>
              <div class="d-screen">
                <span class="mono">{p.name}</span>
                <span class="mono d-note">Screens from Figma</span>
              </div>
            </div>
          </div>

          <div class="t-body">
            <h3>{p.name}</h3>
            <p>{p.headline}</p>
            <div class="t-foot">
              <div class="t-metrics">
                {p.metrics.map(m => <span><b>{m.value}</b> {m.label}</span>)}
              </div>
              <span class="t-tags mono">{p.tags.join(' · ')}</span>
            </div>
          </div>
        </a>
      </li>
    );})}
  </ul>
  <div class="cursor mono" id="cursor" aria-hidden="true"><span>View case study</span> ↗</div>
</section>

<script is:inline>
  (function () {
    const grid = document.getElementById('grid'), c = document.getElementById('cursor');
    if (!matchMedia('(hover: hover) and (pointer: fine)').matches) return;
    let x = 0, y = 0, cx = 0, cy = 0, raf = null;
    const loop = () => { cx += (x - cx) * .2; cy += (y - cy) * .2; c.style.transform = `translate(${cx}px, ${cy}px)`; raf = requestAnimationFrame(loop); };
    grid.addEventListener('pointermove', e => { x = e.clientX; y = e.clientY; const a = e.target.closest('[data-cursor]'); if (a) c.firstChild.textContent = a.dataset.cursor; });
    grid.addEventListener('pointerenter', e => { cx = x = e.clientX; cy = y = e.clientY; c.classList.add('on'); if (!raf) loop(); });
    grid.addEventListener('pointerleave', () => { c.classList.remove('on'); cancelAnimationFrame(raf); raf = null; });
  })();
</script>

<style>
  .work { padding-block: clamp(64px, 10vw, 140px) 0; position: relative; }
  .work-head { display: flex; justify-content: space-between; align-items: end; gap: 16px; margin-bottom: 28px; flex-wrap: wrap; }
  .work-head h2 { margin: 0; font-size: clamp(48px, 9vw, 136px); line-height: .88; letter-spacing: -.055em; font-weight: 800; }
  .work-head .serif { font-weight: 400; letter-spacing: -.025em; }

  /* Full-bleed, edge-to-edge grid (ref: Ben Doan) */
  .grid { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(6, 1fr); }
  .tile { grid-column: span 2; position: relative; background: var(--world); color: var(--on-world); min-height: 560px; overflow: hidden; transition: filter .5s var(--ease); }
  .tile-lg { grid-column: span 3; min-height: 640px; }
  .tile::before { /* soft light falloff gives the flat colour depth */
    content: ''; position: absolute; inset: 0; pointer-events: none;
    background: radial-gradient(90% 70% at 50% 40%, rgba(255,255,255,.14), transparent 60%), linear-gradient(180deg, transparent 55%, rgba(0,0,0,.22));
  }
  .tile a { position: absolute; inset: 0; display: flex; flex-direction: column; padding: clamp(18px, 2vw, 28px); text-decoration: none; }
  @media (hover: hover) and (pointer: fine) { .tile a { cursor: none; } }

  /* Hover spotlight */
  @media (hover: hover) {
    .grid:hover .tile:not(:hover) { filter: saturate(.3) brightness(.6); }
    .tile:hover .device { transform: translateY(-10px) rotate(-1.2deg) scale(1.02); }
  }

  .t-top { display: flex; justify-content: space-between; opacity: .8; position: relative; }
  .t-media { flex: 1; display: grid; place-items: center; padding: 28px 6% 32px; position: relative; }

  .device { transition: transform .7s var(--ease); filter: drop-shadow(0 30px 40px rgba(0,0,0,.28)); }
  .d-screen { height: 100%; border-radius: inherit; display: grid; place-content: center; gap: 4px; text-align: center;
    background:
      linear-gradient(160deg, color-mix(in oklab, var(--on-world) 16%, transparent), transparent 55%),
      color-mix(in oklab, var(--world) 70%, #000);
    color: color-mix(in oklab, var(--on-world) 75%, transparent); }
  .d-note { opacity: .55; font-size: 10px; }
  .device-phone { width: clamp(150px, 15vw, 210px); aspect-ratio: 9 / 19; border-radius: 30px; padding: 7px; background: #111; box-shadow: inset 0 0 0 1.5px rgba(255,255,255,.18); position: relative; }
  .device-phone .d-screen { border-radius: 24px; }
  .device-phone::after { content: ''; position: absolute; top: 14px; left: 50%; width: 30%; height: 14px; margin-left: -15%; border-radius: 99px; background: #111; }
  .device-laptop { width: min(92%, 460px); aspect-ratio: 16 / 10.6; border-radius: 14px 14px 4px 4px; padding: 8px 8px 12px; background: #141414; box-shadow: inset 0 0 0 1.5px rgba(255,255,255,.16); position: relative; }
  .device-laptop .d-screen { border-radius: 6px; }
  .device-laptop::after { content: ''; position: absolute; left: -7%; right: -7%; bottom: -12px; height: 12px; border-radius: 0 0 14px 14px; background: linear-gradient(#d9d5cc, #a7a398); }

  .t-body { position: relative; }
  .t-body h3 { margin: 0; font-size: clamp(32px, 3.6vw, 56px); letter-spacing: -.045em; line-height: .95; font-weight: 800; }
  .t-body p { margin: 10px 0 18px; font-size: clamp(16px, 1.2vw, 18px); max-width: 34ch; opacity: .92; }
  .t-foot { display: flex; justify-content: space-between; align-items: end; gap: 16px; flex-wrap: wrap; border-top: 1px solid color-mix(in oklab, var(--on-world) 25%, transparent); padding-top: 14px; }
  .t-metrics { display: flex; gap: 20px; flex-wrap: wrap; font-size: 14px; }
  .t-metrics b { font-size: 22px; letter-spacing: -.03em; }
  .t-tags { opacity: .7; font-size: 11px; }
  .soon .d-screen { background: repeating-linear-gradient(90deg, #e9e4da 0 14.28%, #f2a900 14.28% 28.56%, #0b8086 28.56% 42.84%, #1d5c45 42.84% 57.12%, #c92f63 57.12% 71.4%, #b9512b 71.4% 85.68%, #2b36c9 85.68% 100%); color: #111; }

  .cursor { position: fixed; left: 0; top: 0; z-index: 60; pointer-events: none; margin: -20px 0 0 -10px; padding: 10px 14px; border-radius: 99px; background: var(--bg); color: var(--text); font-size: 11px; box-shadow: 0 10px 30px -10px rgba(0,0,0,.4); opacity: 0; scale: .6; transition: opacity .25s, scale .35s var(--ease); white-space: nowrap; }
  .cursor.on { opacity: 1; scale: 1; }

  @media (max-width: 900px) {
    .grid { grid-template-columns: 1fr; }
    .tile, .tile-lg { grid-column: auto; min-height: 540px; }
  }
</style>
