---
// Framed project cards (ref: framed card gallery) with copy and metrics always visible.
// 2 columns on desktop, 1 on mobile, in featured order.
import { featured as projects, others, hasPage } from '../data/projects';
import { Image } from 'astro:assets';
import roqquImg from '../assets/work/roqqu/hero-mockup.webp';
import qashImg from '../assets/work/roqqu/qash-1.webp';
import en1Img from '../assets/work/en1/landing.webp';
import clinkImg from '../assets/work/clink/hero.webp';
import gloverScreen from '../assets/work/glover-lite/dashboard-final.webp';
import weaveImg from '../assets/work/weave/store-1.webp';

type Media = { img: ImageMetadata; mode: 'cover' | 'device'; pos?: string; zoom?: number };
const media: Record<string, Media> = {
  roqqu: { img: roqquImg, mode: 'cover', pos: '55% 50%' },
  qash: { img: qashImg, mode: 'cover', pos: '40% 50%' },
  en1: { img: en1Img, mode: 'cover', pos: '15% 50%' },
  clink: { img: clinkImg, mode: 'cover', pos: '30% 50%' },
  'glover-lite': { img: gloverScreen, mode: 'device' },
  weave: { img: weaveImg, mode: 'cover', pos: '50% 0%', zoom: 1.08 },
};
// tall/short per card keeps the three columns level: each column = one tall + one short
---
<section id="work" class="work" aria-labelledby="work-title">
  <div class="wrap work-head">
    <h2 id="work-title">Selected <span class="serif">work</span></h2>
    <p class="mono muted">{String(projects.length).padStart(2, '0')} featured · 2019 — now</p>
  </div>

  <div class="wrap">
    <ul class="cards" role="list" id="grid">
      {projects.map((p, i) => {
        const m = media[p.slug];
        const link = hasPage(p.slug);
        return (
          <li class="card" style={`--world: var(${p.colour})`}>
            <a href={link ? `/work/${p.slug}` : '#work'} data-cursor={link ? 'View case study' : 'Case study soon'}>
              <div class="media">
                {m && m.mode === 'cover' && (
                  <Image src={m.img} alt="" widths={[600, 1000, 1400]} sizes="(max-width: 900px) 92vw, 46vw" style={`object-position:${m.pos ?? '50% 50%'};--z:${m.zoom ?? 1}`} loading={i < 2 ? 'eager' : 'lazy'} />
                )}
                {m && m.mode === 'device' && (
                  <div class="device-field"><div class="phone"><Image src={m.img} alt="" widths={[300, 520]} sizes="220px" /></div></div>
                )}
                {p.isNew && (
                  <span class="new" aria-label="New">
                    <svg viewBox="0 0 92 44" aria-hidden="true"><path d="M78 9C64 2 30 1 14 9 3 15 2 30 14 36c16 8 52 7 66-1 12-7 10-21-2-26-7-3-17-4-26-3" /></svg>
                    <span>New</span>
                  </span>
                )}
              </div>
              <div class="cap">
                <div class="c-top">
                  <span class="c-name"><i class="dot"></i><strong>{p.name}</strong></span>
                  <span class="mono muted">{String(p.ch).padStart(2, '0')} · {p.years}</span>
                </div>
                <h3>{p.headline}</h3>
                <div class="c-metrics">
                  {p.metrics.map(x => <span><b>{x.value}</b> {x.label}</span>)}
                </div>
                <div class="c-foot">
                  <span class="mono muted tags">{p.tags.join(' · ')}</span>
                  <span class="go">{link ? 'View case study' : 'Coming soon'} <span aria-hidden="true">→</span></span>
                </div>
              </div>
            </a>
          </li>
        );
      })}
    </ul>
  </div>

  <div class="wrap others" aria-labelledby="others-title">
    <h3 id="others-title" class="mono muted">Other projects</h3>
    <ul role="list">
      {others.map(o => (
        <li style={`--world: var(${o.colour})`}>
          <a href={hasPage(o.slug) ? `/work/${o.slug}` : '#work'}>
            <span class="o-dot"></span>
            <span class="o-name">{o.name}</span>
            <span class="o-line">{o.headline}</span>
            <span class="o-metric mono">{o.metrics[0].value} {o.metrics[0].label}</span>
            <span class="o-years mono muted">{o.years}</span>
            <span class="o-arrow" aria-hidden="true">↗</span>
          </a>
        </li>
      ))}
    </ul>
  </div>
  <div class="cursor mono" id="cursor" aria-hidden="true"><span>View case study</span> ↗</div>
</section>

<script is:inline>
  (function () {
    const grid = document.getElementById('grid'), c = document.getElementById('cursor');
    if (!matchMedia('(hover: hover) and (pointer: fine)').matches) return;
    let x = 0, y = 0, cx = 0, cy = 0, raf = null;
    const loop = () => { cx += (x - cx) * .2; cy += (y - cy) * .2; c.style.transform = `translate(${cx}px, ${cy}px)`; raf = requestAnimationFrame(loop); };
    grid.addEventListener('pointermove', e => { x = e.clientX; y = e.clientY; const a = e.target.closest('[data-cursor]'); if (a) c.firstChild.textContent = a.dataset.cursor; });
    grid.addEventListener('pointerenter', e => { cx = x = e.clientX; cy = y = e.clientY; c.classList.add('on'); if (!raf) loop(); });
    grid.addEventListener('pointerleave', () => { c.classList.remove('on'); cancelAnimationFrame(raf); raf = null; });
  })();
</script>

<style>
  .work { padding-block: clamp(64px, 10vw, 140px) 0; position: relative; }
  .work-head { display: flex; justify-content: space-between; align-items: end; gap: 16px; margin-bottom: 28px; flex-wrap: wrap; }
  .work-head h2 { margin: 0; font-size: clamp(48px, 9vw, 136px); line-height: .88; letter-spacing: -.055em; font-weight: 800; }
  .work-head .serif { font-weight: 400; letter-spacing: -.025em; }

  .cards { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: clamp(16px, 2vw, 28px); }

  /* Frame: outer bezel + inset media, caption always visible */
  .card a { display: flex; flex-direction: column; height: 100%; padding: 7px; border-radius: 26px; text-decoration: none; color: inherit;
    background: color-mix(in oklab, var(--surface) 70%, var(--bg));
    box-shadow: inset 0 0 0 1px var(--line), 0 1px 0 var(--hl), 0 20px 40px -30px rgba(0,0,0,.35);
    transition: transform .5s var(--ease), box-shadow .5s var(--ease); }
  .media { position: relative; overflow: hidden; border-radius: 19px; aspect-ratio: 16 / 10.5; background: var(--world); }
  .media > :global(img) { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; transform: scale(var(--z, 1)); transform-origin: 50% 30%; transition: transform 1s var(--ease); }
  .device-field { position: absolute; inset: 0; display: grid; place-items: center; overflow: hidden;
    background: radial-gradient(80% 60% at 50% 35%, rgba(255,255,255,.18), transparent 70%), var(--world); }
  .phone { width: 30%; margin-top: 18%; border-radius: 26px; padding: 5px; background: #111; box-shadow: 0 30px 50px -20px rgba(0,0,0,.5); transition: transform 1s var(--ease); }
  .phone :global(img) { width: 100%; height: auto; border-radius: 21px; display: block; }

  .new { position: absolute; top: 14px; right: 14px; z-index: 2; width: 78px; height: 38px; display: grid; place-items: center; color: #ff2fa0; font: 400 21px var(--f-serif); font-style: italic; }
  .new svg { position: absolute; inset: 0; width: 100%; height: 100%; overflow: visible; }
  .new path { fill: none; stroke: currentColor; stroke-width: 2.2; stroke-linecap: round; stroke-dasharray: 260; stroke-dashoffset: 260; animation: scribble 1.1s .6s var(--ease) forwards; }
  .new span { position: relative; transform: rotate(-4deg); }
  @keyframes scribble { to { stroke-dashoffset: 0; } }
  @media (prefers-reduced-motion: reduce) { .new path { animation: none; stroke-dashoffset: 0; } }

  .cap { display: flex; flex-direction: column; gap: 10px; padding: 18px 14px 12px; flex: 1; }
  .c-top { display: flex; justify-content: space-between; align-items: center; gap: 12px; }
  .c-name { display: inline-flex; align-items: center; gap: 9px; font-size: clamp(20px, 1.8vw, 26px); letter-spacing: -.035em; }
  .dot { width: 10px; height: 10px; border-radius: 50%; background: var(--world); }
  .c-top .mono { font-size: 11px; }
  .cap h3 { margin: 0; font-size: clamp(17px, 1.35vw, 20px); font-weight: 500; line-height: 1.35; letter-spacing: -.01em; color: color-mix(in oklab, var(--text) 82%, transparent); max-width: 42ch; }
  .c-metrics { display: flex; gap: 8px; flex-wrap: wrap; }
  .c-metrics span { font-size: 13.5px; color: var(--muted); background: color-mix(in oklab, var(--world) 9%, transparent); border: 1px solid color-mix(in oklab, var(--world) 22%, transparent); padding: 5px 10px; border-radius: 99px; }
  .c-metrics b { color: var(--text); font-size: 15px; letter-spacing: -.02em; margin-right: 2px; }
  .c-foot { display: flex; justify-content: space-between; align-items: center; gap: 12px; margin-top: auto; padding-top: 12px; border-top: 1px solid var(--line); }
  .tags { font-size: 11px; }
  .go { font-size: 14px; font-weight: 600; white-space: nowrap; }
  .go span { display: inline-block; transition: transform .3s var(--ease); }

  @media (hover: hover) {
    .card a:hover { transform: translateY(-4px); box-shadow: inset 0 0 0 1px var(--line-strong), 0 1px 0 var(--hl), 0 30px 50px -30px rgba(0,0,0,.45); }
    .card a:hover .media > :global(img) { transform: scale(calc(var(--z, 1) * 1.04)); }
    .card a:hover .phone { transform: scale(1.04); }
    .card a:hover .go span { transform: translateX(4px); }
  }
  @media (hover: hover) and (pointer: fine) { .card a { cursor: none; } }
  .card a:focus-visible { outline: 2px solid var(--coin); outline-offset: 3px; }

  @media (max-width: 800px) {
    .cards { grid-template-columns: 1fr; }
    .c-foot .tags { display: none; }
  }

  .others { padding-top: clamp(48px, 7vw, 88px); }
  .others h3 { font-weight: 400; margin: 0 0 12px; }
  .others ul { list-style: none; margin: 0; padding: 0; }
  .others li { border-top: 1.5px solid var(--line); }
  .others li:last-child { border-bottom: 1.5px solid var(--line); }
  .others a { display: grid; grid-template-columns: 16px 160px 1fr auto 110px 24px; gap: 18px; align-items: center; padding: 22px 0; text-decoration: none; transition: padding .35s var(--ease), background .35s; }
  .others a:hover { padding-left: 14px; background: linear-gradient(90deg, color-mix(in oklab, var(--world) 12%, transparent), transparent 70%); }
  .o-dot { width: 12px; height: 12px; border-radius: 50%; background: var(--world); }
  .o-name { font-size: clamp(22px, 2.2vw, 30px); font-weight: 800; letter-spacing: -.035em; }
  .o-line { color: var(--muted); font-size: 16px; }
  .o-metric { background: color-mix(in oklab, var(--world) 16%, transparent); padding: 4px 9px; border-radius: 6px; text-transform: none; letter-spacing: 0; font-size: 12.5px; white-space: nowrap; }
  .o-years { text-align: right; }
  .o-arrow { font-size: 20px; transition: transform .3s var(--ease); }
  .others a:hover .o-arrow { transform: translate(3px, -3px); }
  @media (max-width: 900px) {
    .others a { grid-template-columns: 14px 1fr auto; row-gap: 6px; }
    .o-line { grid-column: 2 / -1; } .o-metric { grid-column: 2; justify-self: start; } .o-years { display: none; } .o-arrow { grid-row: 1; grid-column: 3; }
  }

  .cursor { position: fixed; left: 0; top: 0; z-index: 60; pointer-events: none; margin: -20px 0 0 -10px; padding: 10px 14px; border-radius: 99px; background: var(--text); color: var(--bg); font-size: 11px; box-shadow: 0 10px 30px -10px rgba(0,0,0,.4); opacity: 0; scale: .6; transition: opacity .25s, scale .35s var(--ease); white-space: nowrap; }
  .cursor.on { opacity: 1; scale: 1; }
</style>
