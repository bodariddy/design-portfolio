---
// Numbered list of line illustrations that draw themselves in as each item scrolls into view
// (interaction ref: Jaykay's "What I stick to"; icons and copy are our own).
// SVG layers: .x gold guides fade in → .d ink strokes draw → .a gold accents draw → .pt dot appears.
// Optional idle motion once drawn: .lift (rises and lowers), .blink (gold flashes in turn, use --i), .flip (page turns).
export interface Item { t: string; d: string; svg: string; tag?: string }
interface Props { id: string; label: string; items: Item[]; cols?: 2 | 3; class?: string }
const { id, label, items, cols = 2, class: cls = '' } = Astro.props;
---
<section class:list={['ll wrap', cls]} aria-labelledby={id} style={`--cols:${cols}`}>
  <p class="label">{label}</p>
  <h2 id={id}><slot /></h2>
  <ol class="vals" role="list">
    {items.map((b, i) => (
      <li class="val">
        <b class="mono">{String(i + 1).padStart(2, '0')}</b>
        <svg class="ill" viewBox="0 0 330 200" aria-hidden="true" set:html={b.svg} />
        <h3>{b.t}</h3>
        <p>{b.d}</p>
        {b.tag && <span class="mono tag">{b.tag}</span>}
      </li>
    ))}
  </ol>
</section>

<script is:inline>
  (function () {
    const items = document.querySelectorAll('.ll .val:not(.in)');
    if (!('IntersectionObserver' in window)) { items.forEach(i => i.classList.add('in')); return; }
    const io = new IntersectionObserver(es => es.forEach(e => { if (e.isIntersecting) { e.target.classList.add('in'); io.unobserve(e.target); } }), { rootMargin: '0px 0px -18% 0px' });
    items.forEach(i => io.observe(i));
  })();
</script>

<style>
  .ll { padding-block: var(--section) 0; }
  .ll h2 { font-size: clamp(40px, 5.4vw, 80px); letter-spacing: -.055em; line-height: .95; margin: 12px 0 0; font-weight: 800; }
  .ll h2 :global(.serif) { font-weight: 400; color: var(--accent-text); }
  .vals { list-style: none; margin: clamp(40px, 5vw, 72px) 0 0; padding: 0; display: grid; grid-template-columns: repeat(var(--cols), minmax(0, 1fr)); gap: clamp(56px, 7vw, 96px) clamp(32px, 5vw, 80px); }
  .val { display: grid; grid-template-columns: 64px minmax(0, 1fr); align-items: start; align-content: start; }
  .val > b { grid-row: 1; padding-top: 22px; color: var(--muted); font-weight: 400; }
  .ill { grid-area: 1 / 2; width: 100%; max-width: 340px; height: auto; overflow: visible; }
  .val h3 { grid-column: 2; margin: 22px 0 10px; font-size: clamp(22px, 2vw, 28px); line-height: 1.15; letter-spacing: -.03em; font-weight: 600; }
  .val p { grid-column: 2; margin: 0; max-width: 44ch; font-size: 17px; line-height: 1.6; color: var(--muted); }
  .tag { grid-column: 2; margin-top: 16px; color: var(--muted); }
  [style*='--cols:3'] .val { grid-template-columns: 40px minmax(0, 1fr); }

  .ill :global(.x) { stroke: var(--coin); stroke-width: 1; opacity: 0; transition: opacity .8s .2s; }
  .ill :global(.d) { fill: none; stroke: var(--text); stroke-width: 1.5; stroke-linecap: round; stroke-linejoin: round; stroke-dasharray: 1; stroke-dashoffset: 1; transition: stroke-dashoffset 1.4s cubic-bezier(.45, 0, .2, 1) .35s; }
  .ill :global(.a) { fill: none; stroke: var(--coin); stroke-width: 2; stroke-linecap: round; stroke-linejoin: round; stroke-dasharray: 1; stroke-dashoffset: 1; transition: stroke-dashoffset 1s cubic-bezier(.45, 0, .2, 1) 1.2s; }
  .ill :global(.pt) { fill: var(--coin); opacity: 0; transition: opacity .5s 1.4s; }
  .val.in .ill :global(.x) { opacity: .45; }
  .val.in .ill :global(.d), .val.in .ill :global(.a) { stroke-dashoffset: 0; }
  .val.in .ill :global(.pt) { opacity: 1; }

  /* Idle motion, starts once the drawing has finished; livelier on hover */
  .val { --spd: 1; }
  .val:hover { --spd: .6; }
  .ill :global(.lift) { transform-box: view-box; }
  .ill :global(g[transform]) :global(.d) { stroke-width: 1.25; }
  .ill :global(g[transform]) :global(.a) { stroke-width: 1.7; }
  .val.in .ill :global(.lift) { animation: ll-lift calc(2.8s * var(--spd)) cubic-bezier(.45, 0, .2, 1) 2.4s infinite; }
  .val.in .ill :global(.blink) { animation: ll-blink calc(1.6s * var(--spd)) calc(2.4s + var(--i, 0) * .4s) infinite; }
  .ill :global(.flip) { fill: var(--bg); stroke: var(--text); stroke-width: 1.5; stroke-linejoin: round; opacity: 0; transform-box: view-box; transform-origin: 165px 100px; }
  .val.in .ill :global(.flip) { animation: ll-flip calc(3.2s * var(--spd)) cubic-bezier(.45, 0, .2, 1) 2.4s infinite; }
  @keyframes ll-lift { 0%, 15% { transform: translateY(0); } 45%, 65% { transform: translateY(-22px); } 95%, 100% { transform: translateY(0); } }
  @keyframes ll-blink { 0%, 30% { fill: var(--coin); } 40%, 100% { fill: transparent; } }
  @keyframes ll-flip { 0% { opacity: 1; transform: scaleX(1); } 50% { transform: scaleX(0); } 85% { opacity: 1; transform: scaleX(-1); } 100% { opacity: 0; transform: scaleX(-1); } }

  @media (max-width: 1000px) { [style*='--cols:3'] .vals { grid-template-columns: 1fr 1fr; } }
  @media (max-width: 860px) { .vals { grid-template-columns: 1fr !important; } .val { grid-template-columns: 40px minmax(0, 1fr) !important; } }
  @media (prefers-reduced-motion: reduce) {
    .ill :global(.x) { opacity: .45; transition: none; }
    .ill :global(.d), .ill :global(.a) { stroke-dashoffset: 0; transition: none; }
    .ill :global(.pt) { opacity: 1; transition: none; }
    .val.in .ill :global(*) { animation: none !important; }
  }
</style>
