---
// Experience list (ref: Commissioner): company + role on the left, years on the right.
import { experience } from '../data/site';
interface Props { title?: string }
const { title = 'Where I’ve been' } = Astro.props;
---
<section class="exp wrap" aria-labelledby="exp-title">
  <h2 id="exp-title">{title}</h2>
  <ol role="list">
    {experience.map(([y, c, r]) => (
      <li>
        <span class="who"><strong>{c}</strong><span class="role">{r}</span></span>
        <span class="yrs">{y.replace(' — ', ' to ')}</span>
      </li>
    ))}
  </ol>
</section>

<style>
  .exp { padding-bottom: clamp(80px, 10vw, 140px); }
  h2 { font-size: clamp(20px, 1.8vw, 26px); font-weight: 500; letter-spacing: -.02em; margin: 0 0 clamp(20px, 3vw, 40px); }
  ol { list-style: none; margin: 0; padding: 0; }
  li { display: flex; justify-content: space-between; align-items: baseline; gap: 24px; padding: clamp(18px, 2vw, 26px) 0; border-bottom: 1px solid var(--line); font-size: clamp(17px, 1.5vw, 22px); letter-spacing: -.015em; }
  .who { display: flex; flex-wrap: wrap; align-items: baseline; column-gap: 14px; row-gap: 2px; }
  .who strong { font-weight: 500; }
  .role, .yrs { color: var(--muted); }
  .yrs { white-space: nowrap; font-variant-numeric: tabular-nums; }
  @media (max-width: 600px) { li { flex-direction: column; gap: 4px; } .who { flex-direction: column; } }
</style>
