---
import { experience } from '../data/site';
interface Props { title?: string }
const { title = 'Experience' } = Astro.props;
---
<section class="exp wrap" aria-labelledby="exp-title">
  <h2 id="exp-title" class="mono muted">{title}</h2>
  <ol role="list">
    {experience.map(([y, c, r, m]) => (
      <li><span class="mono muted">{y}</span><strong>{c}</strong><span class="muted role">{r}</span><span class="m">{m}</span></li>
    ))}
  </ol>
</section>

<style>
  .exp { padding-bottom: clamp(80px, 10vw, 140px); }
  h2 { font-weight: 400; margin: 0 0 12px; }
  ol { list-style: none; margin: 0; padding: 0; }
  li { display: grid; grid-template-columns: 150px 1fr 1fr auto; gap: 16px; align-items: baseline; padding: 18px 0; border-top: 1.5px solid var(--line); font-size: 18px; transition: padding .3s var(--ease); }
  li:last-child { border-bottom: 1.5px solid var(--line); }
  li:hover { padding-left: 10px; }
  .m { font-family: var(--f-mono); font-size: 13px; background: color-mix(in oklab, var(--coin) 22%, transparent); padding: 3px 8px; border-radius: 6px; }
  @media (max-width: 760px) { li { grid-template-columns: 1fr auto; } li > span:first-child { grid-column: 1 / -1; } .role { display: none; } }
</style>
