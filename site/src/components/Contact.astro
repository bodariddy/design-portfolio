---
import { site, updated } from '../data/site';
---
<div class="end">
  <section class="contact wrap" id="contact">
    <p class="mono muted">Next transaction</p>
    <h2>Hiring a senior <span class="serif">product designer?</span></h2>
    <p class="sub">I’m looking for my next full-time role on a team building products people rely on.</p>
    <div class="ctas">
      <a class="btn btn-solid btn-xl" href={`mailto:${site.email}`}>{site.email}</a>
      <a class="btn btn-glass" href={site.linkedin} rel="noopener">LinkedIn ↗</a>
      <a class="btn btn-glass" href={site.cv}>Download CV</a>
    </div>
  </section>

  <footer class="foot wrap mono">
    <span>© 2026 {site.name} · Updated {updated}</span><span><span data-lagos-clock>—</span> in Lagos, Nigeria</span><span>Designed &amp; built by me, with AI tools</span>
  </footer>

  <!-- Aurora: project colour worlds glowing up from the bottom edge (ref: Wikicasts) -->
  <div class="aurora" aria-hidden="true"><i></i><i></i><i></i><i></i><i></i></div>
</div>

<script is:inline>
  (function () {
    const els = document.querySelectorAll('[data-lagos-clock]'); if (!els.length) return;
    const f = new Intl.DateTimeFormat('en-GB', { hour: 'numeric', minute: '2-digit', second: '2-digit', hour12: true, timeZone: 'Africa/Lagos' });
    const t = () => { const v = f.format(new Date()).replace(' ', '').toLowerCase(); els.forEach(e => e.textContent = v); };
    t(); setInterval(t, 1000);
  })();
</script>

<style>
  .end { position: relative; overflow: hidden; isolation: isolate; border-top: 1.5px solid var(--line); }
  .contact { position: relative; z-index: 1; padding-block: clamp(72px, 10vw, 140px) clamp(64px, 8vw, 112px); }
  h2 { font-size: clamp(44px, 7.5vw, 120px); line-height: .92; letter-spacing: -.055em; margin: 16px 0 0; font-weight: 800; max-width: 12ch; }
  .serif { font-weight: 400; color: var(--accent-text-2); }
  .sub { font-size: clamp(17px, 1.4vw, 20px); max-width: 46ch; color: var(--muted); margin: 26px 0 30px; }
  .ctas { display: flex; gap: 12px; flex-wrap: wrap; }
  .btn-glass { background: color-mix(in oklab, var(--bg) 55%, transparent); backdrop-filter: blur(10px); -webkit-backdrop-filter: blur(10px); }
  .foot { position: relative; z-index: 1; display: flex; justify-content: space-between; padding-block: 28px; flex-wrap: wrap; gap: 8px; color: color-mix(in oklab, var(--text) 70%, transparent); font-variant-numeric: tabular-nums; }

  /* Dark: a faint haze in the brand gold (--coin), hugging the bottom edge. Light: no colour, just a soft halo. */
  .aurora { position: absolute; inset: auto 0 0 0; height: 26%; z-index: 0; pointer-events: none; display: none;
    -webkit-mask: linear-gradient(to top, #000 0%, rgba(0,0,0,.5) 40%, transparent 100%); mask: linear-gradient(to top, #000 0%, rgba(0,0,0,.5) 40%, transparent 100%); }
  .aurora i { position: absolute; bottom: -55%; height: 100%; border-radius: 50%; filter: blur(80px); background: var(--coin); animation: drift 24s ease-in-out infinite alternate; }
  .aurora i:nth-child(1) { left: -5%; width: 50%; opacity: .08; }
  .aurora i:nth-child(2) { left: 30%; width: 45%; opacity: .1; animation-delay: -8s; }
  .aurora i:nth-child(3) { left: 62%; width: 45%; opacity: .07; animation-delay: -16s; }
  .aurora i:nth-child(4), .aurora i:nth-child(5) { display: none; }
  @keyframes drift { 0% { transform: translate3d(0, 0, 0); } 100% { transform: translate3d(4%, -5%, 0); } }
  :global(:root[data-theme='dark']) .aurora { display: block; }
  @media (prefers-color-scheme: dark) { :global(:root:not([data-theme='light'])) .aurora { display: block; } }

  /* Light-mode halo: barely-there white glow behind the headline */
  .end::before { content: ''; position: absolute; z-index: 0; pointer-events: none; left: -10%; right: 30%; top: 15%; bottom: 10%;
    background: radial-gradient(closest-side, rgba(255,255,255,.5), rgba(255,255,255,.15) 55%, transparent); }
  :global(:root[data-theme='dark']) .end::before { display: none; }
  @media (prefers-color-scheme: dark) { :global(:root:not([data-theme='light'])) .end::before { display: none; } }
  @media (prefers-reduced-motion: reduce) { .aurora i { animation: none; } }
</style>
