---
// "What I believe": line illustrations that draw themselves in as they scroll into view
// (interaction ref: Jaykay's "What I stick to"; icons and copy are our own).
// Layers: .x crosshair guides fade in → .d ink strokes draw → .a gold accents draw → .pt dot appears.
const beliefs = [
  {
    t: 'Clarity is a feature',
    d: 'Especially when someone’s money is on the line. If a nervous first-time user can’t follow it, it isn’t finished.',
    svg: `<path class="x" d="M0 92H330"/><path class="x" d="M165 0V200"/>
      <circle class="d" cx="165" cy="92" r="34" pathLength="1"/>
      <path class="d" d="M189 116L214 141" pathLength="1"/>
      <path class="a" d="M149 92H181M157 80H173M157 104H173" pathLength="1"/>
      <circle class="pt" cx="165" cy="92" r="3"/>`,
  },
  {
    t: 'Good design is measurable',
    d: 'If it doesn’t move a number or remove real pain, it’s decoration. I agree what success looks like before I open Figma.',
    svg: `<path class="x" d="M0 70H330"/><path class="x" d="M222 0V200"/>
      <path class="d" d="M104 150H236M104 150V58" pathLength="1"/>
      <path class="d" d="M124 150V128M154 150V116M184 150V122M214 150V96" pathLength="1"/>
      <path class="a" d="M118 126L150 108L180 116L222 70" pathLength="1"/>
      <circle class="pt" cx="222" cy="70" r="4"/>`,
  },
  {
    t: 'Systems give teams time back',
    d: 'A good design system is the quiet reason a team ships faster next quarter.',
    svg: `<path class="x" d="M0 100H330"/><path class="x" d="M165 0V200"/>
      <rect class="d" x="117" y="52" width="42" height="42" rx="9" pathLength="1"/>
      <rect class="d" x="171" y="52" width="42" height="42" rx="9" pathLength="1"/>
      <rect class="d" x="117" y="106" width="42" height="42" rx="9" pathLength="1"/>
      <rect class="d" x="171" y="106" width="42" height="42" rx="9" pathLength="1"/>
      <path class="a" d="M138 63L149 73L138 83L127 73Z" pathLength="1"/>
      <path class="a" d="M192 63L203 73L192 83L181 73ZM138 117L149 127L138 137L127 127ZM192 117L203 127L192 137L181 127Z" pathLength="1"/>
      <circle class="pt" cx="165" cy="100" r="3"/>`,
  },
  {
    t: 'Own the problem, not the ticket',
    d: 'Founding Clink taught me to care about the outcome, not just the hand-off.',
    svg: `<path class="x" d="M0 100H330"/><path class="x" d="M236 0V200"/>
      <path class="d" d="M96 70H190V88A12 12 0 0 0 190 112V130H96V112A12 12 0 0 0 96 88Z" pathLength="1"/>
      <path class="d" d="M120 92H162M120 108H150" pathLength="1"/>
      <path class="a" d="M202 100H236M226 90L236 100L226 110" pathLength="1"/>
      <circle class="a" cx="236" cy="100" r="14" pathLength="1"/>
      <circle class="pt" cx="236" cy="100" r="3.5"/>`,
  },
];
---
<section class="bel wrap" aria-labelledby="b-title">
  <p class="mono muted">What I believe</p>
  <h2 id="b-title">Principles I <span class="serif">design by.</span></h2>
  <ol class="vals" role="list">
    {beliefs.map((b, i) => (
      <li class="val">
        <b class="mono">{String(i + 1).padStart(2, '0')}</b>
        <svg class="ill" viewBox="0 0 330 200" aria-hidden="true" set:html={b.svg} />
        <h3>{b.t}</h3>
        <p>{b.d}</p>
      </li>
    ))}
  </ol>
</section>

<script is:inline>
  (function () {
    const items = document.querySelectorAll('.bel .val');
    if (!('IntersectionObserver' in window)) { items.forEach(i => i.classList.add('in')); return; }
    const io = new IntersectionObserver(es => es.forEach(e => { if (e.isIntersecting) { e.target.classList.add('in'); io.unobserve(e.target); } }), { rootMargin: '0px 0px -18% 0px' });
    items.forEach(i => io.observe(i));
  })();
</script>

<style>
  .bel { padding-block: clamp(56px, 8vw, 110px); border-top: 1.5px solid var(--line); }
  .bel h2 .serif { font-weight: 400; color: var(--accent-text); }
  .bel h2 { font-size: clamp(40px, 5.4vw, 80px); letter-spacing: -.055em; line-height: .95; margin: 12px 0 0; font-weight: 800; }
  .vals { list-style: none; margin: clamp(40px, 5vw, 72px) 0 0; padding: 0; display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: clamp(56px, 7vw, 96px) clamp(32px, 6vw, 96px); }
  .val { display: grid; grid-template-columns: 64px minmax(0, 1fr); align-items: start; align-content: start; }
  .val > b { grid-row: 1; padding-top: 22px; color: var(--muted); font-weight: 400; }
  .ill { grid-area: 1 / 2; width: 100%; max-width: 340px; height: auto; overflow: visible; }
  .val h3 { grid-column: 2; margin: 22px 0 10px; font-size: clamp(22px, 2vw, 28px); line-height: 1.15; letter-spacing: -.03em; font-weight: 600; }
  .val p { grid-column: 2; margin: 0; max-width: 44ch; font-size: 17px; line-height: 1.6; color: var(--muted); }

  .ill :global(.x) { stroke: var(--coin); stroke-width: 1; opacity: 0; transition: opacity .8s .2s; }
  .ill :global(.d) { fill: none; stroke: var(--text); stroke-width: 1.5; stroke-linecap: round; stroke-linejoin: round; stroke-dasharray: 1; stroke-dashoffset: 1; transition: stroke-dashoffset 1.4s cubic-bezier(.45, 0, .2, 1) .35s; }
  .ill :global(.a) { fill: none; stroke: var(--coin); stroke-width: 2; stroke-linecap: round; stroke-linejoin: round; stroke-dasharray: 1; stroke-dashoffset: 1; transition: stroke-dashoffset 1s cubic-bezier(.45, 0, .2, 1) 1.2s; }
  .ill :global(.pt) { fill: var(--coin); opacity: 0; transition: opacity .5s 1.4s; }
  .val.in .ill :global(.x) { opacity: .45; }
  .val.in .ill :global(.d), .val.in .ill :global(.a) { stroke-dashoffset: 0; }
  .val.in .ill :global(.pt) { opacity: 1; }

  @media (max-width: 860px) { .vals { grid-template-columns: 1fr; } .val { grid-template-columns: 40px minmax(0, 1fr); } }
  @media (prefers-reduced-motion: reduce) {
    .ill :global(.x) { opacity: .45; transition: none; }
    .ill :global(.d), .ill :global(.a) { stroke-dashoffset: 0; transition: none; }
    .ill :global(.pt) { opacity: 1; transition: none; }
  }
</style>
