---
// Case-study template (structure ref: billguo.me/work/ncs):
// split hero (centred title + device on a gold plate) → meta + intro → overview (problem / what I did / results)
// → body chapters in a narrow centred column, media on soft gold plates → up next. A sticky chapter navigator sits at the bottom.
import Base from './Base.astro';
import Nav from '../components/Nav.astro';
import Contact from '../components/Contact.astro';
import { projects, hasPage } from '../data/projects';
import { Image } from 'astro:assets';
import '../styles/case.css';
import Stage from '../components/case/Stage.astro';
import type { ImageMetadata } from 'astro';

interface Props {
  slug: string;
  title: string;
  sub: string;
  meta: [string, string][];
  hero: ImageMetadata;
  heroAlt: string;
  tldr: { problem: string; did: string };
  results: { value: string; label: string }[];
  stage?: { kind: 'phone' | 'browser'; screens: ImageMetadata[]; url?: string };
}
const { slug, title, sub, meta, hero, heroAlt, tldr, results, stage } = Astro.props;
const i = projects.findIndex(p => p.slug === slug);
const p = projects[i];
const live = projects.filter(x => hasPage(x.slug));
const next = live[(live.findIndex(x => x.slug === slug) + 1) % live.length];
const body = await Astro.slots.render('default');
const words = (body.replace(/<[^>]+>/g, ' ') + ' ' + sub + ' ' + tldr.problem + ' ' + tldr.did).split(/\s+/).filter(Boolean).length;
const mins = Math.max(3, Math.round(words / 230));
const outcome = results.slice(0, 2).map(r => `${r.value} ${r.label}`).join(' · ');
---
<Base title={`${p.name}: ${title} · Tosin Lasisi`} description={sub}>
  <div style={`--world: var(${p.colour})`}>
    <Nav />
    <main id="main">
      <!-- HERO: centred title left, device on a gold plate bleeding right -->
      <header class="c-hero" data-chapter="Overview">
        <div class="c-title">
          <span class="c-tag mono">{p.tags.slice(0, 2).join(' · ')}</span>
          <h1>{title}</h1>
          <p class="c-out">{outcome}</p>
          <p class="c-by mono"><span>{p.name}</span><span>{mins} min read</span></p>
        </div>
        <div class="c-media plate-vars">
          {stage
            ? <Stage kind={stage.kind} screens={stage.screens} url={stage.url} label={heroAlt} />
            : <div class="c-img"><Image src={hero} alt={heroAlt} widths={[800, 1400]} sizes="(max-width: 900px) 94vw, 50vw" loading="eager" /></div>}
        </div>
      </header>

      <!-- META + INTRO -->
      <section class="c-intro wrap">
        <dl class="c-meta">
          {meta.map(([k, v]) => <div><dt class="mono">{k}</dt><dd>{v}</dd></div>)}
        </dl>
        <p class="c-lede">{sub}</p>
      </section>

      <!-- OVERVIEW -->
      <section class="c-over">
        <p class="divider mono"><span>Overview</span></p>
        <div class="col">
          <p class="lbl label">The problem</p>
          <p class="big-p">{tldr.problem}</p>
          <p class="lbl label">What I did</p>
          <p class="body-p">{tldr.did}</p>
        </div>
        <ul class="results" role="list" data-reveal>
          {results.map(r => <li><b>{r.value}</b><span>{r.label}</span></li>)}
        </ul>
      </section>

      <article class="body case-body">
        <Fragment set:html={body} />
      </article>

      <section class="c-next" data-chapter="Up next">
        <p class="divider mono"><span>Up next</span></p>
        <a href={`/work/${next.slug}`} class="n-link" style={`--world: var(${next.colour})`}>
          <span class="mono n-ch">{next.featured === false ? 'Other project' : `CH ${String(next.ch).padStart(2, '0')}`}</span>
          <strong><i></i>{next.name} <span aria-hidden="true">→</span></strong>
          <span class="n-line">{next.headline}</span>
        </a>
      </section>

      <Contact />
    </main>

    <!-- Chapter navigator (ref: Bill Guo): back · chapter reel with progress ticks · prev/next -->
    <nav class="chap away" aria-label="Case study chapters">
      <a class="c-side c-back" href="/#work" aria-label="Back to work"><span aria-hidden="true">←</span></a>
      <div class="c-cap">
        <div class="c-stack">
          <div class="c-reel"><div class="c-track" id="chap-track"></div></div>
          <div class="c-ticks" id="chap-ticks" aria-hidden="true"></div>
        </div>
      </div>
      <div class="c-side c-steps">
        <button data-dir="-1" aria-label="Previous chapter">↑</button>
        <button data-dir="1" aria-label="Next chapter">↓</button>
      </div>
    </nav>
  </div>
</Base>

<script is:inline>
  addEventListener('DOMContentLoaded', () => {
    const clean = t => t.replace(/^\d+\s*·\s*/, '').replace(/\s+/g, ' ').trim();
    const chapters = [];
    document.querySelectorAll('[data-chapter], .case-body .sec, .case-body .part, .case-body .iwall').forEach(el => {
      let name = el.dataset.chapter;
      if (!name && el.classList.contains('sec')) name = clean(el.querySelector('.side')?.textContent || '');
      if (!name && el.classList.contains('part')) name = clean(el.querySelector('h2')?.textContent || '');
      if (!name && el.classList.contains('iwall')) name = 'Details';
      if (name) chapters.push({ el, name });
    });
    // keep document order
    chapters.sort((a, b) => a.el.compareDocumentPosition(b.el) & Node.DOCUMENT_POSITION_FOLLOWING ? -1 : 1);
    const nav = document.querySelector('.chap'), track = document.getElementById('chap-track'), ticks = document.getElementById('chap-ticks');
    const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
    const go = i => { const t = chapters[Math.min(chapters.length - 1, Math.max(0, i))]; scrollTo({ top: t.el.getBoundingClientRect().top + scrollY - 80, behavior: reduce ? 'auto' : 'smooth' }); };
    const labels = chapters.map((c, k) => { const b = document.createElement('button'); b.type = 'button'; b.className = 'mono'; b.textContent = c.name; b.addEventListener('click', () => go(k)); track.appendChild(b); return b; });
    const tks = chapters.map(() => { const t = document.createElement('i'); ticks.appendChild(t); return t; });
    const steps = nav.querySelectorAll('[data-dir]');
    let cur = -1;
    const mark = i => {
      cur = i;
      labels.forEach((l, k) => { const d = Math.abs(k - i); l.toggleAttribute('data-active', k === i); if (k === i) l.setAttribute('aria-current', 'true'); else l.removeAttribute('aria-current'); l.style.filter = d ? `blur(${Math.min(1.2, .55 + d * .25)}px)` : 'none'; });
      tks.forEach((t, k) => { t.classList.toggle('lit', k < i); t.classList.toggle('now', k === i); });
      // Capsule widens to fit the active name (the reel's clear zone is the middle 56%), capped to the screen
      const l = labels[i], max = Math.min(420, innerWidth - (innerWidth < 768 ? 96 : 240));
      const reel = Math.min(max - 56, Math.max(150, (l.offsetWidth + 8) / .56));
      nav.style.setProperty('--reel', reel + 'px'); nav.style.setProperty('--cap', Math.max(220, reel + 56) + 'px');
      track.style.transform = `translateX(${reel / 2 - (l.offsetLeft + l.offsetWidth / 2)}px)`;
      steps[0].setAttribute('aria-disabled', i === 0); steps[1].setAttribute('aria-disabled', i === chapters.length - 1);
    };
    const onScroll = () => {
      const y = innerHeight * 0.35; let idx = 0;
      chapters.forEach((c, k) => { if (c.el.getBoundingClientRect().top <= y) idx = k; });
      if (idx !== cur) mark(idx);
      nav.classList.toggle('away', scrollY < 200 || (document.getElementById('contact')?.getBoundingClientRect().top ?? 1e9) < innerHeight * .7);
    };
    addEventListener('scroll', onScroll, { passive: true }); addEventListener('resize', () => cur >= 0 && mark(cur));
    document.fonts?.ready.then(() => cur >= 0 && mark(cur));
    onScroll();
    steps.forEach(b => b.addEventListener('click', () => { if (b.getAttribute('aria-disabled') !== 'true') go(cur + +b.dataset.dir); }));
  });
</script>

<style>
  /* Hero */
  .c-hero { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.15fr); align-items: center; min-height: min(92vh, 900px); padding-top: 20px; }
  .c-title { display: grid; justify-items: center; text-align: center; gap: 0; padding: 40px clamp(20px, 4vw, 64px); }
  .c-tag { padding: 4px 9px; --tc: color-mix(in oklab, var(--world) 75%, var(--text)); border: 1px solid var(--tc); color: var(--tc); }
  :global(:root[data-theme='dark']) .c-tag { --tc: color-mix(in oklab, var(--world) 45%, white); }
  @media (prefers-color-scheme: dark) { :global(:root:not([data-theme='light'])) .c-tag { --tc: color-mix(in oklab, var(--world) 45%, white); } }
  h1 { font-size: clamp(38px, 4.4vw, 66px); line-height: 1.02; letter-spacing: -.045em; font-weight: 700; margin: 26px 0 0; max-width: 14ch; }
  .c-out { margin: 22px 0 0; font-size: clamp(16px, 1.3vw, 19px); color: var(--muted); max-width: 34ch; }
  .c-by { margin: 22px 0 0; display: flex; gap: 22px; color: var(--muted); }
  .c-media { align-self: stretch; display: grid; }
  .c-media :global(.stage) { height: auto; min-height: 520px; border-radius: 22px 0 0 22px; }
  .c-img { border-radius: 22px 0 0 22px; overflow: hidden; background: var(--plate); padding: clamp(28px, 4vw, 56px) 0 clamp(28px, 4vw, 56px) clamp(28px, 4vw, 56px); display: grid; align-items: center; }
  .c-img :global(img) { width: 100%; height: auto; border-radius: 12px 0 0 12px; box-shadow: 0 30px 60px -30px rgba(0,0,0,.35); }

  /* Meta + intro */
  .c-intro { display: grid; grid-template-columns: 220px minmax(0, 620px); justify-content: center; gap: clamp(32px, 6vw, 96px); padding-block: clamp(64px, 9vw, 120px) clamp(32px, 5vw, 64px); }
  .c-meta { margin: 0; display: grid; gap: 18px; align-content: start; }
  .c-meta dt { color: var(--muted); font-size: 11px; }
  .c-meta dd { margin: 4px 0 0; font-size: 15px; line-height: 1.4; }
  .c-lede { margin: 0; font-family: var(--f-serif); font-size: clamp(24px, 2.2vw, 32px); line-height: 1.25; letter-spacing: -.01em; }

  /* Shared: dividers, narrow column */
  .divider { display: flex; align-items: center; gap: 18px; max-width: 900px; margin: 0 auto clamp(40px, 6vw, 72px); padding-inline: var(--gutter); color: var(--muted); font-size: 11px; }
  .divider::before, .divider::after { content: ''; flex: 1; border-top: 1px dashed var(--line-strong); opacity: .35; }
  .col { max-width: 640px; margin: 0 auto; padding-inline: var(--gutter); box-sizing: content-box; }
  .lbl { display: flex; align-items: center; gap: 8px; margin: 0 0 10px; }
  .lbl::before { content: ''; width: 6px; height: 6px; border-radius: 50%; background: var(--coin); }
  .big-p { font-family: var(--f-serif); font-size: clamp(24px, 2.2vw, 32px); line-height: 1.25; margin: 0 0 36px; }
  .body-p { font-size: 17px; line-height: 1.65; color: color-mix(in oklab, var(--text) 85%, transparent); margin: 0; }

  .c-over { padding-block: clamp(40px, 6vw, 80px) clamp(40px, 6vw, 72px); }
  .results { list-style: none; max-width: 900px; margin: clamp(40px, 5vw, 64px) auto 0; padding: 0 var(--gutter); display: grid; grid-template-columns: repeat(auto-fit, minmax(150px, 1fr)); gap: 12px; }
  .results li { display: grid; gap: 6px; padding: 18px 18px 16px; border-radius: 16px; background: var(--surface); box-shadow: inset 0 0 0 1px var(--line); }
  .results b { font-size: clamp(30px, 3vw, 44px); letter-spacing: -.05em; line-height: 1; font-variant-numeric: tabular-nums; }
  .results span { color: var(--muted); font-size: 14px; line-height: 1.35; }

  /* Up next */
  .c-next { padding-block: clamp(64px, 9vw, 120px) clamp(40px, 6vw, 80px); }
  .n-link { display: grid; justify-items: center; gap: 10px; text-align: center; text-decoration: none; padding-inline: var(--gutter); }
  .n-ch { color: var(--muted); }
  .n-link strong { display: inline-flex; align-items: center; gap: 14px; font-size: clamp(44px, 6vw, 88px); letter-spacing: -.055em; line-height: 1; }
  .n-link strong i { width: .22em; height: .22em; border-radius: 50%; background: var(--world); }
  .n-link strong span { display: inline-block; transition: transform .4s var(--ease); }
  .n-link:hover strong span { transform: translateX(12px); }
  .n-line { color: var(--muted); font-size: 18px; max-width: 40ch; }

  /* Chapter navigator (ref: Bill Guo) */
  .chap { --h: 44px; --gap: 10px; position: fixed; z-index: 40; bottom: max(18px, env(safe-area-inset-bottom)); left: 50%; transform: translateX(-50%); display: flex; align-items: center; gap: var(--gap); transition: opacity .3s, transform .45s var(--ease); }
  @media (min-width: 1200px) { .chap { left: calc(50% + var(--rail) / 2); } }
  .chap.away { opacity: 0; transform: translate(-50%, 14px); pointer-events: none; }
  .c-side, .c-cap { height: var(--h); border-radius: 99px; background: #1f1d1b; color: #f3efe6; box-shadow: inset 0 0 0 1px rgba(255,255,255,.06), 0 14px 30px -14px rgba(0,0,0,.55); font-family: var(--f-mono); }
  .c-side { display: inline-flex; align-items: center; justify-content: center; position: relative; z-index: 1; transition: transform .38s var(--ease) .42s, opacity .3s .42s; }
  .c-back { width: 52px; text-decoration: none; color: var(--coin); font-size: 15px; }
  .c-steps { gap: 18px; padding: 0 20px; }
  .c-steps button { appearance: none; border: 0; background: none; color: inherit; font: inherit; font-size: 15px; padding: 0; cursor: pointer; position: relative; transition: opacity .2s, transform .2s; }
  .c-steps button::after { content: ''; position: absolute; inset: -14px -9px; }
  .c-steps button[aria-disabled='true'] { opacity: .3; cursor: default; }
  .c-back:hover, .c-steps button:not([aria-disabled='true']):hover { opacity: .7; }
  .c-steps button:active { transform: scale(.94); }
  /* Capsule: grows out of a dot when the bar appears; side pills then slide out from behind it */
  .c-cap { position: relative; z-index: 2; width: var(--cap, 220px); clip-path: inset(0 round 99px); transition: clip-path .5s cubic-bezier(.2, .6, .2, 1) .1s, width .45s cubic-bezier(.2, .7, .1, 1); }
  .chap.away .c-cap { clip-path: inset(0 calc(50% - var(--h) / 2) round 99px); transition-delay: 0s; transition-duration: .2s; }
  .chap.away .c-back { transform: translateX(calc(100% + var(--gap))); opacity: 0; transition-delay: 0s; }
  .chap.away .c-steps { transform: translateX(calc(-100% - var(--gap))); opacity: 0; transition-delay: 0s; }
  .c-stack { position: absolute; inset: 0; display: grid; place-items: center; transition: opacity .25s .45s; }
  .chap.away .c-stack { opacity: 0; transition-delay: 0s; }
  .c-reel { width: var(--reel, 150px); overflow: clip; transition: width .45s cubic-bezier(.2, .7, .1, 1); padding-block: 14px; margin-block: -14px; margin-top: -10px;
    -webkit-mask-image: linear-gradient(90deg, transparent 0, #000 22% 78%, transparent 100%); mask-image: linear-gradient(90deg, transparent 0, #000 22% 78%, transparent 100%); }
  .c-track { display: flex; width: max-content; transition: transform .5s cubic-bezier(.2, .7, .1, 1); }
  .c-track :global(button) { appearance: none; border: 0; background: none; color: inherit; padding: 0 9.6px; font-size: 10.5px; line-height: 14px; letter-spacing: .06em; white-space: nowrap; cursor: pointer; opacity: .45; transition: opacity .2s, filter .3s; }
  .c-track :global(button:hover) { opacity: .75; }
  .c-track :global(button[data-active]) { opacity: 1; }
  .c-ticks { position: absolute; top: 50%; left: 50%; transform: translateX(-50%); margin-top: 11px; display: flex; gap: 4.8px; }
  .c-ticks :global(i) { width: 3.2px; height: 1.6px; background: rgba(243,239,230,.3); transition: background .3s, width .3s var(--ease); }
  .c-ticks :global(i.lit) { background: #f3efe6; }
  .c-ticks :global(i.now) { background: var(--coin); width: 8px; }
  @media (max-width: 767px) { .c-steps { display: none; } }
  @media (prefers-reduced-motion: reduce) { .c-track, .c-cap, .c-side, .c-stack { transition: none; } }

  @media (max-width: 900px) {
    .c-hero { grid-template-columns: 1fr; min-height: 0; }
    .c-title { padding-top: 32px; }
    .c-media :global(.stage) { min-height: 440px; border-radius: 18px; margin-inline: var(--gutter); }
    .c-img { border-radius: 18px; margin-inline: var(--gutter); padding: 24px; }
    .c-img :global(img) { border-radius: 10px; }
    .c-intro { grid-template-columns: 1fr; }
    .c-meta { grid-template-columns: 1fr 1fr; }
  }
</style>
